<!DOCTYPE html><html  lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shopify Admin API integration for AI agents and workflows | StackOS</title><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://stackos.flowmonkey.io/_og/s/o_pt7ae1.png"><meta name="twitter:image:src" content="https://stackos.flowmonkey.io/_og/s/o_pt7ae1.png"><meta property="og:image" content="https://stackos.flowmonkey.io/_og/s/o_pt7ae1.png"><meta property="og:image:type" content="image/png"><meta property="og:image:width" content="1200"><meta name="twitter:image:width" content="1200"><meta property="og:image:height" content="600"><meta name="twitter:image:height" content="600"><link rel="stylesheet" href="/_nuxt/entry.HVu_FLFq.css" crossorigin><link rel="stylesheet" href="/_nuxt/_slug_.B6ti37_s.css" crossorigin><link rel="stylesheet" href="/_nuxt/useIntegrationCatalog.wtjwSlpy.css" crossorigin><link rel="stylesheet" href="/_nuxt/integrationRoutePolicy.BHfEqrhY.css" crossorigin><link rel="stylesheet" href="/_nuxt/LibraryFrame.CD2pOTex.css" crossorigin><link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"><link rel="preload" as="fetch" crossorigin="anonymous" href="/library/integrations/shopify/_payload.json?aa586fb3-d485-480b-909f-6b016269cb06"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/CHhb2Wy-.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/Dpv_aybD.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/CxoQ3gne.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/B6iqfEGV.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/Df8p5hZf.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/C4_Tu-xR.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/DHOT6Yra.js"><script type="module" src="/_nuxt/CHhb2Wy-.js" crossorigin></script><link rel="icon" type="image/png" href="/images/stackos-icon.png"><link rel="apple-touch-icon" href="/images/stackos-icon.png"><link rel="alternate" type="application/rss+xml" title="StackOS Library" href="/feed.xml"><meta name="description" content="Static-token Shopify Admin GraphQL provider. Tokens stay daemon-held; agents can only run curated action catalog operations. Explore 58 listed Shopify Admin API actions and see how it fits into StackOS workflows."><meta name="theme-color" content="#090b10"><meta property="og:type" content="website"><meta property="og:title" content="Shopify Admin API integration for AI agents and workflows | StackOS"><meta property="og:description" content="Static-token Shopify Admin GraphQL provider. Tokens stay daemon-held; agents can only run curated action catalog operations. Explore 58 listed Shopify Admin API actions and see how it fits into StackOS workflows."><meta name="twitter:title" content="Shopify Admin API integration for AI agents and workflows | StackOS"><meta name="twitter:description" content="Static-token Shopify Admin GraphQL provider. Tokens stay daemon-held; agents can only run curated action catalog operations. Explore 58 listed Shopify Admin API actions and see how it fits into StackOS workflows."><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"><link rel="canonical" href="https://stackos.flowmonkey.io/library/integrations/shopify/"><meta property="og:url" content="https://stackos.flowmonkey.io/library/integrations/shopify/"><script type="application/ld+json" data-hid="integration-software">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"Shopify Admin API","description":"Static-token Shopify Admin GraphQL provider. Tokens stay daemon-held; agents can only run curated action catalog operations.","applicationCategory":"Shopify","url":"https://shopify.dev/docs/api/admin-graphql"}</script><script type="application/ld+json" data-hid="integration-faq">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What can the Shopify Admin API integration do in StackOS?","acceptedAnswer":{"@type":"Answer","text":"The current catalog includes 58 Shopify Admin API actions across Analytics, Customers, Inventory, Orders, Products. The exact actions used depend on the workflow and approval rules."}},{"@type":"Question","name":"Does StackOS replace Shopify Admin API?","acceptedAnswer":{"@type":"Answer","text":"No. Shopify Admin API remains the tool that performs its part of the job. StackOS organizes the workflow, keeps status and dependencies visible, and calls the tool only when the plan reaches the right approved action."}}]}</script><meta property="og:site_name" content="StackOS"><script id="unhead:payload" type="application/json">{"titleTemplate":"%s | StackOS"}</script></head><body><div id="__nuxt"><!--[--><div id="top" class="site library-site" data-v-c771a7e2 data-v-e230b581><a class="skip-link" href="#main" data-v-e230b581>Skip to content</a><header class="site-header" data-v-e230b581><div class="shell site-header__inner"><a href="/" class="brand" aria-label="StackOS home"><img src="/images/stackos-icon.png" alt width="36" height="36"><span>StackOS</span><small>Work, organized</small></a><nav class="site-nav site-nav--desktop" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav><details class="mobile-menu"><summary role="button" aria-label="Toggle navigation" aria-controls="site-navigation"><span></span><span></span></summary><nav id="site-navigation" class="site-nav site-nav--mobile" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav></details></div></header><div class="library-nav" aria-label="Library sections" data-v-e230b581><div class="shell library-nav__inner" data-v-e230b581><a href="/library/" class="" data-v-e230b581>Library</a><a href="/library/workflows/" class="" data-v-e230b581>Workflows</a><a href="/library/agents/" class="" data-v-e230b581>Agents</a><a href="/library/orchestrators/" class="" data-v-e230b581>Orchestrators</a><a href="/library/integrations/" class="" data-v-e230b581>Integrations</a><a href="/library/articles/" class="" data-v-e230b581>Articles</a></div></div><main id="main" class="library-main" data-v-e230b581><nav class="library-breadcrumbs" aria-label="Breadcrumb" data-v-e230b581 data-v-59391fa3><div class="shell" data-v-59391fa3><ol data-v-59391fa3><!--[--><li data-v-59391fa3><a href="/" class="" data-v-59391fa3>Home</a></li><li data-v-59391fa3><a href="/library/" class="" data-v-59391fa3>Library</a></li><li data-v-59391fa3><a href="/library/integrations/" class="" data-v-59391fa3>Integrations</a></li><li data-v-59391fa3><a aria-current="page" href="/library/integrations/shopify/" class="router-link-active router-link-exact-active" data-v-59391fa3>Shopify Admin API</a></li><!--]--></ol></div></nav><!--[--><section class="integration-detail-hero" style="--integration-color:#95bf47;" data-v-c771a7e2><div class="shell integration-detail-hero__grid" data-v-c771a7e2><div data-v-c771a7e2><div class="integration-detail-hero__identity" data-v-c771a7e2><span class="integration-mark is-large has-logo" style="--mark-color:#95bf47;" aria-hidden="true" data-v-c771a7e2 data-v-aa7c01f7><img src="/images/integrations/shopify-icon.png" alt="" data-v-aa7c01f7></span><div data-v-c771a7e2><a aria-current="page" href="/library/integrations/shopify/" class="router-link-active router-link-exact-active" data-v-c771a7e2><span data-v-c771a7e2>Shopify plugin</span></a><h1 data-v-c771a7e2>Shopify Admin API</h1></div></div><p data-v-c771a7e2>Static-token Shopify Admin GraphQL provider. Tokens stay daemon-held; agents can only run curated action catalog operations.</p><div class="integration-detail-hero__meta" data-v-c771a7e2><span data-v-c771a7e2><strong data-v-c771a7e2>58</strong> listed actions</span><span data-v-c771a7e2><strong data-v-c771a7e2>5</strong> capability groups</span></div></div><aside data-v-c771a7e2><p data-v-c771a7e2>Use Shopify Admin API inside a complete plan.</p><strong data-v-c771a7e2>StackOS keeps the request, status, approvals, and proof connected around every tool action.</strong><div data-v-c771a7e2><!--[--><a href="https://shopify.dev/docs/api/admin-graphql" target="_blank" rel="noopener noreferrer" data-v-c771a7e2>Visit tool <span aria-hidden="true" data-v-c771a7e2>↗</span></a><a href="https://shopify.dev/docs/api/admin-graphql/latest" target="_blank" rel="noopener noreferrer" data-v-c771a7e2>Documentation <span aria-hidden="true" data-v-c771a7e2>↗</span></a><a href="https://admin.shopify.com/" target="_blank" rel="noopener noreferrer" data-v-c771a7e2>Open console <span aria-hidden="true" data-v-c771a7e2>↗</span></a><a href="https://help.shopify.com/" target="_blank" rel="noopener noreferrer" data-v-c771a7e2>Support <span aria-hidden="true" data-v-c771a7e2>↗</span></a><!--]--></div></aside></div></section><section class="integration-facts" data-provider-facts="shopify" data-v-c771a7e2><div class="shell" data-v-c771a7e2><div class="library-section__heading" data-v-c771a7e2><div data-v-c771a7e2><p class="eyebrow" data-v-c771a7e2>Connection facts</p><h2 data-v-c771a7e2>What the Shopify Admin API connector actually exposes.</h2></div><p data-v-c771a7e2>These details come from the current StackOS provider manifest and action catalog. They describe the available connection—not a promise that every workflow will use every action.</p></div><dl class="integration-facts__grid" data-v-c771a7e2><div data-v-c771a7e2><dt data-v-c771a7e2>Connection method</dt><dd data-v-c771a7e2>api-token</dd></div><div data-v-c771a7e2><dt data-v-c771a7e2>Setup</dt><dd data-v-c771a7e2>Use an existing token from a Shopify custom app with only the scopes needed for the enabled actions.</dd></div><div data-v-c771a7e2><dt data-v-c771a7e2>Capability groups</dt><dd data-v-c771a7e2>Analytics, Customers, Inventory, Orders, Products</dd></div><div data-v-c771a7e2><dt data-v-c771a7e2>Action boundaries</dt><dd data-v-c771a7e2><span data-v-c771a7e2>39 read actions</span><span data-v-c771a7e2>19 write actions</span><!----><!----><!----></dd></div></dl></div></section><!----><!----><section class="integration-actions" data-v-c771a7e2><div class="shell" data-v-c771a7e2><div class="library-section__heading" data-v-c771a7e2><div data-v-c771a7e2><p class="eyebrow" data-v-c771a7e2>Action catalog</p><h2 data-v-c771a7e2>Actions listed for Shopify Admin API.</h2></div><p data-v-c771a7e2>Actions listed for this integration. Individual descriptions note availability limits. A workflow still decides which actions belong in the job and where approval is required.</p></div><div class="integration-action-tools" data-v-c771a7e2><label for="action-query" data-v-c771a7e2><span data-v-c771a7e2>Search Shopify Admin API actions</span><input id="action-query" value="" type="search" placeholder="Search 58 actions…" autocomplete="off" data-v-c771a7e2></label><div class="integration-action-tools__filters" data-v-c771a7e2><button class="is-active" type="button" data-v-c771a7e2>All <span data-v-c771a7e2>58</span></button><!--[--><button class="" type="button" data-v-c771a7e2>Analytics <span data-v-c771a7e2>15</span></button><button class="" type="button" data-v-c771a7e2>Customers <span data-v-c771a7e2>9</span></button><button class="" type="button" data-v-c771a7e2>Inventory <span data-v-c771a7e2>7</span></button><button class="" type="button" data-v-c771a7e2>Orders <span data-v-c771a7e2>12</span></button><button class="" type="button" data-v-c771a7e2>Products <span data-v-c771a7e2>15</span></button><!--]--></div><p data-v-c771a7e2>58 matching actions</p></div><div class="integration-action-grid" data-v-c771a7e2><!--[--><article data-v-c771a7e2><h3 data-v-c771a7e2>Add Customer Tag</h3><div data-v-c771a7e2><span data-v-c771a7e2>Customers</span><b class="is-write" data-v-c771a7e2>Can make changes</b></div><p data-v-c771a7e2>Add one or more tags to a customer using the tagsAdd mutation.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Add Order Note</h3><div data-v-c771a7e2><span data-v-c771a7e2>Orders</span><b class="is-write" data-v-c771a7e2>Can make changes</b></div><p data-v-c771a7e2>Add or update a private note on an order.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Add Order Tag</h3><div data-v-c771a7e2><span data-v-c771a7e2>Orders</span><b class="is-write" data-v-c771a7e2>Can make changes</b></div><p data-v-c771a7e2>Add one or more tags to an order.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Adjust Inventory</h3><div data-v-c771a7e2><span data-v-c771a7e2>Inventory</span><b class="is-write" data-v-c771a7e2>Can make changes</b></div><p data-v-c771a7e2>Adjust inventory quantity by a delta (positive to add, negative to subtract) at a specific location. Uses the inventoryAdjustQuantities mutation.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Conversion Funnel</h3><div data-v-c771a7e2><span data-v-c771a7e2>Analytics</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Conversion funnel metrics: sessions, orders, customers, and ShopifyQL conversion_rate (values in shop currency)</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Create Collection</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-write" data-v-c771a7e2>Can make changes</b></div><p data-v-c771a7e2>Create a new collection with title and optional description.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Create Customer</h3><div data-v-c771a7e2><span data-v-c771a7e2>Customers</span><b class="is-write" data-v-c771a7e2>Can make changes</b></div><p data-v-c771a7e2>Create a new customer with firstName, lastName, email, phone, tags, and note.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Create Draft Order</h3><div data-v-c771a7e2><span data-v-c771a7e2>Orders</span><b class="is-write" data-v-c771a7e2>Can make changes</b></div><p data-v-c771a7e2>Create a draft order with line items, optional customer, shipping address, and note. Returns draft order with calculated totals.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Create Product</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-write" data-v-c771a7e2>Can make changes</b></div><p data-v-c771a7e2>Create a new product with title, description, vendor, product type, status, and tags.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Create Product Variant</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-write" data-v-c771a7e2>Can make changes</b></div><p data-v-c771a7e2>Add a variant to an existing product with price, SKU, and options. Options format: &quot;OptionName:Value&quot; (e.g. &quot;Size:Large,Color:Red&quot;).</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Customer Cohort Analysis</h3><div data-v-c771a7e2><span data-v-c771a7e2>Analytics</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Customer cohort analysis showing customers, orders, and sales grouped by time period</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Customer Lifetime Value</h3><div data-v-c771a7e2><span data-v-c771a7e2>Analytics</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Customer lifetime value report from the ShopifyQL customers dataset showing customer_name, total_amount_spent, and total_orders. Note: groups by customer_name, which may not be unique across customers with the same name.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Discount Performance</h3><div data-v-c771a7e2><span data-v-c771a7e2>Analytics</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Analyze discount impact on sales: discounted vs total revenue, discount percentage, and total discount amount</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Collection</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get a single collection by its Shopify GID. Returns collection details with its products.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Customer</h3><div data-v-c771a7e2><span data-v-c771a7e2>Customers</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get a single customer by ID with full detail including addresses, note, state, and createdAt.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Customer Lifetime Value</h3><div data-v-c771a7e2><span data-v-c771a7e2>Customers</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get customer amountSpent, numberOfOrders, and first/last visible order dates. True first/last order history can require Shopify read_all_orders access beyond the default order window.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Customer Orders</h3><div data-v-c771a7e2><span data-v-c771a7e2>Customers</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>List visible orders for a specific customer. Historical orders beyond Shopify&#39;s default order window can require read_all_orders access.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Inventory By Sku</h3><div data-v-c771a7e2><span data-v-c771a7e2>Inventory</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Look up inventory items by SKU string. Uses the inventoryItems query with a SKU filter.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Inventory Item</h3><div data-v-c771a7e2><span data-v-c771a7e2>Inventory</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get an inventory item by its Shopify GID. Returns SKU, tracked status, and inventory levels per location with quantities.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Location Inventory</h3><div data-v-c771a7e2><span data-v-c771a7e2>Inventory</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get all inventory items at a specific location. Returns items with SKU, available, and incoming quantities.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Order</h3><div data-v-c771a7e2><span data-v-c771a7e2>Orders</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get a single order by ID with customer, addresses, notes, tags, fulfillments, and the first 50 line items plus pagination metadata.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Order By Name</h3><div data-v-c771a7e2><span data-v-c771a7e2>Orders</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get an order by its exact Shopify order name (for example, #1001 or a custom prefixed name). Uses Shopify order search by name.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Order Fulfillment Status</h3><div data-v-c771a7e2><span data-v-c771a7e2>Orders</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get the fulfillment status of an order with tracking numbers, carrier, and tracking URLs for each fulfillment.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Order Timeline</h3><div data-v-c771a7e2><span data-v-c771a7e2>Orders</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get the event timeline for an order (comments, status changes, fulfillments, refunds).</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Product</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get a single product by its Shopify GID. Returns product detail with first 10 media and first 100 variants plus pagination metadata.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Product By Handle</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get a product by its URL handle (slug). Returns product detail with first 10 media and first 100 variants plus pagination metadata.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Get Product Variant</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get a single product variant by its Shopify GID. Returns full variant detail including price, SKU, and selected options.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Inventory Risk Report</h3><div data-v-c771a7e2><span data-v-c771a7e2>Analytics</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Products at overstock or understock risk based on sales velocity</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>List Collections</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>List collections with cursor pagination. Returns collection title, handle, products count, and image.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>List Customers</h3><div data-v-c771a7e2><span data-v-c771a7e2>Customers</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>List customers with cursor pagination. Returns displayName, email, ordersCount, totalSpent, tags, and state.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>List Inventory Levels</h3><div data-v-c771a7e2><span data-v-c771a7e2>Inventory</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>List inventory levels across all locations. Returns location name and available/committed/on_hand quantities. Supports cursor pagination.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>List Orders</h3><div data-v-c771a7e2><span data-v-c771a7e2>Orders</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>List visible orders with optional filtering by status, financial status, and fulfillment status. Returns order details including first-page line items, customer summary, and fulfillment tracking.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>List Product Variants</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>List variants for a product with cursor pagination. Returns variant details including price, SKU, inventory, and selected options.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>List Products</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>List products with optional filtering by status, vendor, and product type. Supports cursor pagination.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Low Stock Report</h3><div data-v-c771a7e2><span data-v-c771a7e2>Inventory</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Get a report of inventory items below a specified stock threshold. Queries all inventory, filters items with available quantity below threshold, and returns a sorted list with product name, variant title, SKU, available quantity, and location.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Manage Product Tags</h3><div data-v-c771a7e2><span data-v-c771a7e2>Products</span><b class="is-write" data-v-c771a7e2>Can make changes</b></div><p data-v-c771a7e2>Add or remove tags on a product. Provide arrays of tags to add and/or remove.</p></article><!--]--></div><button class="integration-load-more" type="button" data-v-c771a7e2> Show 36 more <span data-v-c771a7e2>(22 remaining)</span></button></div></section><section class="integration-answer" data-v-c771a7e2><div class="detail-body__narrow" data-v-c771a7e2><p class="eyebrow" data-v-c771a7e2>Direct answer</p><h2 data-v-c771a7e2>How does the Shopify Admin API integration work?</h2><p data-v-c771a7e2>People continue using Shopify Admin API as their tool. StackOS adds it to a visible workflow, keeps the work in order, and passes only the approved action to the integration when that stage is ready.</p><ol class="integration-route-flow" style="--route-color:#95bf47;" data-integration-route="shopify" aria-label="How StackOS routes approved work to Shopify Admin API" data-v-c771a7e2 data-v-4eb1f27f><!--[--><li data-v-4eb1f27f><span data-v-4eb1f27f>01</span><strong data-v-4eb1f27f>Your request</strong><small data-v-4eb1f27f>Start in your AI</small></li><li data-v-4eb1f27f><span data-v-4eb1f27f>02</span><strong data-v-4eb1f27f>StackOS plan</strong><small data-v-4eb1f27f>Expands the steps</small></li><li data-v-4eb1f27f><span data-v-4eb1f27f>03</span><strong data-v-4eb1f27f>Shopify Admin API</strong><small data-v-4eb1f27f>Does its bounded part</small></li><li data-v-4eb1f27f><span data-v-4eb1f27f>04</span><strong data-v-4eb1f27f>Checked result</strong><small data-v-4eb1f27f>Keeps the proof</small></li><!--]--></ol></div></section><!----><section class="integration-faq" aria-labelledby="integration-faq-title" data-v-c771a7e2><div class="detail-body__narrow" data-v-c771a7e2><p class="eyebrow" data-v-c771a7e2>Common questions</p><h2 id="integration-faq-title" data-v-c771a7e2>Shopify Admin API and StackOS.</h2><!--[--><details data-v-c771a7e2><summary data-v-c771a7e2>What can the Shopify Admin API integration do in StackOS?</summary><p data-v-c771a7e2>The current catalog includes 58 Shopify Admin API actions across Analytics, Customers, Inventory, Orders, Products. The exact actions used depend on the workflow and approval rules.</p></details><details data-v-c771a7e2><summary data-v-c771a7e2>Does StackOS replace Shopify Admin API?</summary><p data-v-c771a7e2>No. Shopify Admin API remains the tool that performs its part of the job. StackOS organizes the workflow, keeps status and dependencies visible, and calls the tool only when the plan reaches the right approved action.</p></details><!--]--></div></section><!--]--></main><footer class="site-footer" data-v-e230b581 data-v-5f58f905><div class="shell site-footer__grid" data-v-5f58f905><a href="/" class="footer-brand" data-v-5f58f905><img src="/images/stackos-icon.png" alt width="42" height="42" loading="lazy" decoding="async" data-v-5f58f905><div data-v-5f58f905><strong data-v-5f58f905>StackOS</strong><span data-v-5f58f905>Keep AI-powered work clear, connected, and moving.</span></div></a><div class="site-footer__links" data-v-5f58f905><div data-v-5f58f905><span data-v-5f58f905>Explore</span><a href="/#why" class="" data-v-5f58f905>Why StackOS</a><a href="/getting-started/" class="" data-v-5f58f905>Getting started</a><a href="/library/" class="" data-v-5f58f905>Library</a><a href="/library/workflows/" class="" data-v-5f58f905>Workflows</a><a href="/library/articles/" class="" data-v-5f58f905>Articles</a></div><div data-v-5f58f905><span data-v-5f58f905>Build</span><a href="/#security" class="" data-v-5f58f905>Security</a><a href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac" data-v-5f58f905>Download</a><a href="https://github.com/flowmonkeyio/StackOS" target="_blank" rel="noreferrer" data-v-5f58f905>GitHub ↗</a></div></div><div class="site-footer__status" data-v-5f58f905><span class="status-dot" data-v-5f58f905></span><div data-v-5f58f905><strong data-v-5f58f905>Runs on your Mac</strong><small data-v-5f58f905>Your work. Your apps. Your private logins.</small></div></div></div><div class="shell site-footer__bottom" data-v-5f58f905><span data-v-5f58f905>StackOS · Your AI tool works. StackOS keeps the work organized.</span><span data-v-5f58f905>Runs locally.</span></div></footer></div><!----><!--]--></div><div id="teleports"></div><script>window.__NUXT__={};window.__NUXT__.config={public:{siteUrl:"https://stackos.flowmonkey.io",gaMeasurementId:"G-KPZXCGXGG5",downloadUrl:"https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg",scripts:{googleAnalytics:{id:"G-KPZXCGXGG5",scriptOptions:{bundle:false}}},"nuxt-scripts":{version:"",prefix:"/_scripts",defaultScriptOptions:{trigger:"onNuxtReady"},googleStaticMapsProxy:"",endpoints:{}},mdc:{components:{prose:true,map:{},customElements:[]},headings:{anchorLinks:{h1:false,h2:true,h3:true,h4:true,h5:false,h6:false}},highlight:false},"nuxt-seo-utils-version":"8.3.1","seo-utils":{canonicalQueryWhitelist:["page","sort","filter","search","q","category","tag"],canonicalLowercase:true,tagPriority:"low",separator:"",titleSeparator:""},content:{wsUrl:""},"nuxt-robots":{version:"6.1.2",isNuxtContentV2:false,debug:false,credits:true,groups:[{userAgent:["*"],disallow:[""],allow:[],contentUsage:[],contentSignal:[],_indexable:true,_rules:[],_normalized:true}],sitemap:["/sitemap.xml"],header:true,robotsEnabledValue:"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",robotsDisabledValue:"noin