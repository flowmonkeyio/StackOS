><link rel="icon" type="image/png" href="/images/stackos-icon.png"><link rel="apple-touch-icon" href="/images/stackos-icon.png"><link rel="alternate" type="application/rss+xml" title="StackOS Library" href="/feed.xml"><meta name="description" content="Pipedrive CRM provider contract for organizations, people, deals, activities, and notes. Explore 2 listed Pipedrive actions and see how it fits into StackOS workflows."><meta name="theme-color" content="#090b10"><meta property="og:type" content="website"><meta property="og:title" content="Pipedrive integration for AI agents and workflows | StackOS"><meta property="og:description" content="Pipedrive CRM provider contract for organizations, people, deals, activities, and notes. Explore 2 listed Pipedrive actions and see how it fits into StackOS workflows."><meta name="twitter:title" content="Pipedrive integration for AI agents and workflows | StackOS"><meta name="twitter:description" content="Pipedrive CRM provider contract for organizations, people, deals, activities, and notes. Explore 2 listed Pipedrive actions and see how it fits into StackOS workflows."><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"><link rel="canonical" href="https://stackos.flowmonkey.io/library/integrations/pipedrive/"><meta property="og:url" content="https://stackos.flowmonkey.io/library/integrations/pipedrive/"><script type="application/ld+json" data-hid="integration-software">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"Pipedrive","description":"Pipedrive CRM provider contract for organizations, people, deals, activities, and notes.","applicationCategory":"GTM And RevOps","url":"https://www.pipedrive.com/"}</script><script type="application/ld+json" data-hid="integration-faq">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What can the Pipedrive integration do in StackOS?","acceptedAnswer":{"@type":"Answer","text":"The current catalog includes 2 Pipedrive actions across Pipeline Management. The exact actions used depend on the workflow and approval rules."}},{"@type":"Question","name":"Does StackOS replace Pipedrive?","acceptedAnswer":{"@type":"Answer","text":"No. Pipedrive remains the tool that performs its part of the job. StackOS organizes the workflow, keeps status and dependencies visible, and calls the tool only when the plan reaches the right approved action."}}]}</script><meta property="og:site_name" content="StackOS"><script id="unhead:payload" type="application/json">{"titleTemplate":"%s | StackOS"}</script></head><body><div id="__nuxt"><!--[--><div id="top" class="site library-site" data-v-c771a7e2 data-v-e230b581><a class="skip-link" href="#main" data-v-e230b581>Skip to content</a><header class="site-header" data-v-e230b581><div class="shell site-header__inner"><a href="/" class="brand" aria-label="StackOS home"><img src="/images/stackos-icon.png" alt width="36" height="36"><span>StackOS</span><small>Work, organized</small></a><nav class="site-nav site-nav--desktop" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav><details class="mobile-menu"><summary role="button" aria-label="Toggle navigation" aria-controls="site-navigation"><span></span><span></span></summary><nav id="site-navigation" class="site-nav site-nav--mobile" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav></details></div></header><div class="library-nav" aria-label="Library sections" data-v-e230b581><div class="shell library-nav__inner" data-v-e230b581><a href="/library/" class="" data-v-e230b581>Library</a><a href="/library/workflows/" class="" data-v-e230b581>Workflows</a><a href="/library/agents/" class="" data-v-e230b581>Agents</a><a href="/library/orchestrators/" class="" data-v-e230b581>Orchestrators</a><a href="/library/integrations/" class="" data-v-e230b581>Integrations</a><a href="/library/articles/" class="" data-v-e230b581>Articles</a></div></div><main id="main" class="library-main" data-v-e230b581><nav class="library-breadcrumbs" aria-label="Breadcrumb" data-v-e230b581 data-v-59391fa3><div class="shell" data-v-59391fa3><ol data-v-59391fa3><!--[--><li data-v-59391fa3><a href="/" class="" data-v-59391fa3>Home</a></li><li data-v-59391fa3><a href="/library/" class="" data-v-59391fa3>Library</a></li><li data-v-59391fa3><a href="/library/integrations/" class="" data-v-59391fa3>Integrations</a></li><li data-v-59391fa3><a aria-current="page" href="/library/integrations/pipedrive/" class="router-link-active router-link-exact-active" data-v-59391fa3>Pipedrive</a></li><!--]--></ol></div></nav><!--[--><section class="integration-detail-hero" style="--integration-color:#ff9f73;" data-v-c771a7e2><div class="shell integration-detail-hero__grid" data-v-c771a7e2><div data-v-c771a7e2><div class="integration-detail-hero__identity" data-v-c771a7e2><span class="integration-mark is-large has-logo is-wordmark" style="--mark-color:#ff9f73;" aria-hidden="true" data-v-c771a7e2 data-v-aa7c01f7><img src="/images/integrations/pipedrive.png" alt="" data-v-aa7c01f7></span><div data-v-c771a7e2><a href="/library/integrations/plugins/gtm/" class="" data-v-c771a7e2><span data-v-c771a7e2>GTM And RevOps plugin</span></a><h1 data-v-c771a7e2>Pipedrive</h1></div></div><p data-v-c771a7e2>Pipedrive CRM provider contract for organizations, people, deals, activities, and notes.</p><div class="integration-detail-hero__meta" data-v-c771a7e2><span data-v-c771a7e2><strong data-v-c771a7e2>2</strong> listed actions</span><span data-v-c771a7e2><strong data-v-c771a7e2>1</strong> capability groups</span></div></div><aside data-v-c771a7e2><p data-v-c771a7e2>Use Pipedrive inside a complete plan.</p><strong data-v-c771a7e2>StackOS keeps the request, status, approvals, and proof connected around every tool action.</strong><div data-v-c771a7e2><!--[--><a href="https://www.pipedrive.com/" target="_blank" rel="noopener noreferrer" data-v-c771a7e2>Visit tool <span aria-hidden="true" data-v-c771a7e2>↗</span></a><a href="https://developers.pipedrive.com/docs/api/v1" target="_blank" rel="noopener noreferrer" data-v-c771a7e2>Documentation <span aria-hidden="true" data-v-c771a7e2>↗</span></a><a href="https://www.pipedrive.com/en/register" target="_blank" rel="noopener noreferrer" data-v-c771a7e2>Create account <span aria-hidden="true" data-v-c771a7e2>↗</span></a><a href="https://app.pipedrive.com/" target="_blank" rel="noopener noreferrer" data-v-c771a7e2>Open console <span aria-hidden="true" data-v-c771a7e2>↗</span></a><!--]--></div></aside></div></section><section class="integration-facts" data-provider-facts="pipedrive" data-v-c771a7e2><div class="shell" data-v-c771a7e2><div class="library-section__heading" data-v-c771a7e2><div data-v-c771a7e2><p class="eyebrow" data-v-c771a7e2>Connection facts</p><h2 data-v-c771a7e2>What the Pipedrive connector actually exposes.</h2></div><p data-v-c771a7e2>These details come from the current StackOS provider manifest and action catalog. They describe the available connection—not a promise that every workflow will use every action.</p></div><dl class="integration-facts__grid" data-v-c771a7e2><div data-v-c771a7e2><dt data-v-c771a7e2>Connection method</dt><dd data-v-c771a7e2>oauth-or-api-token</dd></div><div data-v-c771a7e2><dt data-v-c771a7e2>Setup</dt><dd data-v-c771a7e2>Register a Pipedrive app with the fixed StackOS callback and deals:read plus search:read app scopes, then use Connect with Pipedrive. For private personal integrations, the supported personal API token method remains available.</dd></div><div data-v-c771a7e2><dt data-v-c771a7e2>Capability groups</dt><dd data-v-c771a7e2>Pipeline Management</dd></div><div data-v-c771a7e2><dt data-v-c771a7e2>Action boundaries</dt><dd data-v-c771a7e2><span data-v-c771a7e2>2 read actions</span><!----><!----><!----><!----></dd></div></dl></div></section><!----><!----><section class="integration-actions" data-v-c771a7e2><div class="shell" data-v-c771a7e2><div class="library-section__heading" data-v-c771a7e2><div data-v-c771a7e2><p class="eyebrow" data-v-c771a7e2>Action catalog</p><h2 data-v-c771a7e2>Actions listed for Pipedrive.</h2></div><p data-v-c771a7e2>Actions listed for this integration. Individual descriptions note availability limits. A workflow still decides which actions belong in the job and where approval is required.</p></div><div class="integration-action-tools" data-v-c771a7e2><label for="action-query" data-v-c771a7e2><span data-v-c771a7e2>Search Pipedrive actions</span><input id="action-query" value="" type="search" placeholder="Search 2 actions…" autocomplete="off" data-v-c771a7e2></label><!----><p data-v-c771a7e2>2 matching actions</p></div><div class="integration-action-grid" data-v-c771a7e2><!--[--><article data-v-c771a7e2><h3 data-v-c771a7e2>List Pipedrive Deals</h3><div data-v-c771a7e2><span data-v-c771a7e2>Pipeline Management</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>List bounded Pipedrive deal context for pipeline review.</p></article><article data-v-c771a7e2><h3 data-v-c771a7e2>Search Pipedrive Deals</h3><div data-v-c771a7e2><span data-v-c771a7e2>Pipeline Management</span><b class="is-read" data-v-c771a7e2>Reads data</b></div><p data-v-c771a7e2>Search bounded Pipedrive deal context for pipeline review.</p></article><!--]--></div><!----></div></section><section class="integration-answer" data-v-c771a7e2><div class="detail-body__narrow" data-v-c771a7e2><p class="eyebrow" data-v-c771a7e2>Direct answer</p><h2 data-v-c771a7e2>How does the Pipedrive integration work?</h2><p data-v-c771a7e2>People continue using Pipedrive as their tool. StackOS adds it to a visible workflow, keeps the work in order, and passes only the approved action to the integration when that stage is ready.</p><ol class="integration-route-flow" style="--route-color:#ff9f73;" data-integration-route="pipedrive" aria-label="How StackOS routes approved work to Pipedrive" data-v-c771a7e2 data-v-4eb1f27f><!--[--><li data-v-4eb1f27f><span data-v-4eb1f27f>01</span><strong data-v-4eb1f27f>Your request</strong><small data-v-4eb1f27f>Start in your AI</small></li><li data-v-4eb1f27f><span data-v-4eb1f27f>02</span><strong data-v-4eb1f27f>StackOS plan</strong><small data-v-4eb1f27f>Expands the steps</small></li><li data-v-4eb1f27f><span data-v-4eb1f27f>03</span><strong data-v-4eb1f27f>Pipedrive</strong><small data-v-4eb1f27f>Does its bounded part</small></li><li data-v-4eb1f27f><span data-v-4eb1f27f>04</span><strong data-v-4eb1f27f>Checked result</strong><small data-v-4eb1f27f>Keeps the proof</small></li><!--]--></ol></div></section><section class="related-section" data-v-c771a7e2><div class="shell" data-v-c771a7e2><div class="library-section__heading" data-v-c771a7e2><div data-v-c771a7e2><p class="eyebrow eyebrow--dark" data-v-c771a7e2>More from GTM And RevOps</p><h2 data-v-c771a7e2>Related integrations.</h2></div><a href="/library/integrations/plugins/gtm/" class="" data-v-c771a7e2>See the plugin →</a></div><div class="integration-related-grid" data-v-c771a7e2><!--[--><article class="integration-card" style="--integration-color:#ff9f73;" data-v-c771a7e2 data-v-480388d2><div class="integration-card__top" data-v-480388d2><span class="integration-mark is-small has-logo" style="--mark-color:#ff9f73;" aria-hidden="true" data-v-480388d2 data-v-aa7c01f7><img src="/images/integrations/apollo.png" alt="" data-v-aa7c01f7></span><span data-v-480388d2>GTM And RevOps</span></div><a href="/library/integrations/apollo/" class="integration-card__body" data-v-480388d2><h2 data-v-480388d2>Apollo</h2><p data-v-480388d2>Apollo provider contract for people search and endpoint-specific enrichment.</p></a><div class="integration-card__capabilities" data-v-480388d2><!--[--><span data-v-480388d2>Enrichment</span><span data-v-480388d2>Lead Management</span><!--]--><!----></div><footer data-v-480388d2><a href="/library/integrations/apollo/" class="" data-v-480388d2>5 actions <span aria-hidden="true" data-v-480388d2>→</span></a><a href="https://www.apollo.io/" target="_blank" rel="noopener noreferrer" data-v-480388d2> Visit tool <span aria-hidden="true" data-v-480388d2>↗</span></a></footer></article><article class="integration-card" style="--integration-color:#ff9f73;" data-v-c771a7e2 data-v-480388d2><div class="integration-card__top" data-v-480388d2><span class="integration-mark is-small has-logo is-wordmark is-dark-logo" style="--mark-color:#ff9f73;" aria-hidden="true" data-v-480388d2 data-v-aa7c01f7><img src="/images/integrations/clay.png" alt="" data-v-aa7c01f7></span><span data-v-480388d2>GTM And RevOps</span></div><a href="/library/integrations/clay/" class="integration-card__body" data-v-480388d2><h2 data-v-480388d2>Clay</h2><p data-v-480388d2>Clay enrichment and workflow provider contract.</p></a><div class="integration-card__capabilities" data-v-480388d2><!--[--><span data-v-480388d2>Enrichment</span><!--]--><!----></div><footer data-v-480388d2><a href="/library/integrations/clay/" class="" data-v-480388d2>2 actions <span aria-hidden="true" data-v-480388d2>→</span></a><a href="https://www.clay.com/" target="_blank" rel="noopener noreferrer" data-v-480388d2> Visit tool <span aria-hidden="true" data-v-480388d2>↗</span></a></footer></article><article class="integration-card" style="--integration-color:#ff9f73;" data-v-c771a7e2 data-v-480388d2><div class="integration-card__top" data-v-480388d2><span class="integration-mark is-small has-logo" style="--mark-color:#ff9f73;" aria-hidden="true" data-v-480388d2 data-v-aa7c01f7><img src="/images/integrations/clearbit.png" alt="" data-v-aa7c01f7></span><span data-v-480388d2>GTM And RevOps</span></div><a href="/library/integrations/clearbit-by-hubspot/" class="integration-card__body" data-v-480388d2><h2 data-v-480388d2>Clearbit By HubSpot</h2><p data-v-480388d2>Clearbit by HubSpot enrichment provider contract.</p></a><div class="integration-card__capabilities" data-v-480388d2><!--[--><span data-v-480388d2>Enrichment</span><!--]--><!----></div><footer data-v-480388d2><a href="/library/integrations/clearbit-by-hubspot/" class="" data-v-480388d2>1 actions <span aria-hidden="true" data-v-480388d2>→</span></a><a href="https://clearbit.com/" target="_blank" rel="noopener noreferrer" data-v-480388d2> Visit tool <span aria-hidden="true" data-v-480388d2>↗</span></a></footer></article><!--]--></div></div></section><section class="integration-faq" aria-labelledby="integration-faq-title" data-v-c771a7e2><div class="detail-body__narrow" data-v-c771a7e2><p class="eyebrow" data-v-c771a7e2>Common questions</p><h2 id="integration-faq-title" data-v-c771a7e2>Pipedrive and StackOS.</h2><!--[--><details data-v-c771a7e2><summary data-v-c771a7e2>What can the Pipedrive integration do in StackOS?</summary><p data-v-c771a7e2>The current catalog includes 2 Pipedrive actions across Pipeline Management. The exact actions used depend on the workflow and approval rules.</p></details><details data-v-c771a7e2><summary data-v-c771a7e2>Does StackOS replace Pipedrive?</summary><p data-v-c771a7e2>No. Pipedrive remains the tool that performs its part of the job. StackOS organizes the workflow, keeps status and dependencies visible, and calls the tool only when the plan reaches the right approved action.</p></details><!--]--></div></section><!--]--></main><footer class="site-footer" data-v-e230b581 data-v-5f58f905><div class="shell site-footer__grid" data-v-5f58f905><a href="/" class="footer-brand" data-v-5f58f905><img src="/images/stackos-icon.png" alt width="42" height="42" loading="lazy" decoding="async" data-v-5f58f905><div data-v-5f58f905><strong data-v-5f58f905>StackOS</strong><span data-v-5f58f905>Keep AI-powered work clear, connected, and moving.</span></div></a><div class="site-footer__links" data-v-5f58f905><div data-v-5f58f905><span data-v-5f58f905>Explore</span><a href="/#why" class="" data-v-5f58f905>Why StackOS</a><a href="/getting-started/" class="" data-v-5f58f905>Getting started</a><a href="/library/" class="" data-v-5f58f905>Library</a><a href="/library/workflows/" class="" data-v-5f58f905>Workflows</a><a href="/library/articles/" class="" data-v-5f58f905>Articles</a></div><div data-v-5f58f905><span data-v-5f58f905>Build</span><a href="/#security" class="" data-v-5f58f905>Security</a><a href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac" data-v-5f58f905>Download</a><a href="https://github.com/flowmonkeyio/StackOS" target="_blank" rel="noreferrer" data-v-5f58f905>GitHub ↗</a></div></div><div class="site-footer__status" data-v-5f58f905><span class="status-dot" data-v-5f58f905></span><div data-v-5f58f905><strong data-v-5f58f905>Runs on your Mac</strong><small data-v-5f58f905>Your work. Your apps. Your private logins.</small></div></div></div><div class="shell site-footer__bottom" data-v-5f58f905><span data-v-5f58f905>StackOS · Your AI tool works. StackOS keeps the work organized.</span><span data-v-5f58f905>Runs locally.</span></div></footer></div><!----><!--]--></div><div id="teleports"></div><script>window.__NUXT__={};window.__NUXT__.config={public:{siteUrl:"https://stackos.flowmonkey.io",gaMeasurementId:"G-KPZXCGXGG5",downloadUrl:"https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg",scripts:{googleAnalytics:{id:"G-KPZXCGXGG5",scriptOptions:{bundle:false}}},"nuxt-scripts":{version:"",prefix:"/_scripts",defaultScriptOptions:{trigger:"onNuxtReady"},googleStaticMapsProxy:"",endpoints:{}},mdc:{components:{prose:true,map:{},customElements:[]},headings:{anchorLinks:{h1:false,h2:true,h3:true,h4:true,h5:false,h6:false}},highlight:false},"nuxt-seo-utils-version":"8.3.1","seo-utils":{canonicalQueryWhitelist:["page","sort","filter","search","q","category","tag"],canonicalLowercase:true,tagPriority:"low",separator:"",titleSeparator:""},content:{wsUrl:""},"nuxt-robots":{version:"6.1.2",isNuxtContentV2:false,debug:false,credits:true,groups:[{userAgent:["*"],disallow:[""],allow:[],contentUsage:[],contentSignal:[],_indexable:true,_rules:[],_normalized:true}],sitemap:["/sitemap.xml"],header:true,robotsEnabledValue:"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",robotsDisabledValue:"noindex, nofollow",cacheControl:"max-age=14400, must-revalidate",botDetection:true,pageMetaRobots:{}},"nuxt-og-image":{defaults:{emojis:"noto",extension:"png",width:1200,height:600,cacheMaxAgeSeconds:259200},hasServerRuntime:false}},app:{baseURL:"/",buildId:"aa586fb3-d485-480b-909f-6b016269cb06",buildAssetsDir:"/_nuxt/",cdnURL:""}}</script><script type="application/ld+json" data-nuxt-schema-org="true" data-hid="schema-org-graph">{"@context":"https://schema.org","@graph":[{"@id":"https://stackos.flowmonkey.io/#website","@type":"WebSite","description":"The place where AI-powered work becomes clear, connected, and accountable.","inLanguage":"en","name":"StackOS","url":"https://stackos.flowmonkey.io/","publisher":{"@id":"https://stackos.flowmonkey.io/#identity"}},{"@i