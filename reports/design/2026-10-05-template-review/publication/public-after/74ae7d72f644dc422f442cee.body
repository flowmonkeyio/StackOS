ad" as="script" crossorigin href="/_nuxt/B6FA65gX.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/Df8p5hZf.js"><script type="module" src="/_nuxt/CHhb2Wy-.js" crossorigin></script><link rel="icon" type="image/png" href="/images/stackos-icon.png"><link rel="apple-touch-icon" href="/images/stackos-icon.png"><link rel="alternate" type="application/rss+xml" title="StackOS Library" href="/feed.xml"><meta name="description" content="A source-linked account brief focused on fit, timing, risks, and the next useful action."><meta name="theme-color" content="#090b10"><meta property="og:type" content="website"><meta property="og:title" content="GTM Account Research workflow | StackOS"><meta property="og:description" content="A source-linked account brief focused on fit, timing, risks, and the next useful action."><meta name="twitter:title" content="GTM Account Research workflow | StackOS"><meta name="twitter:description" content="A source-linked account brief focused on fit, timing, risks, and the next useful action."><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"><link rel="canonical" href="https://stackos.flowmonkey.io/library/workflows/gtm-account-research/"><meta property="og:url" content="https://stackos.flowmonkey.io/library/workflows/gtm-account-research/"><meta property="og:site_name" content="StackOS"><script id="unhead:payload" type="application/json">{"titleTemplate":"%s | StackOS"}</script></head><body><div id="__nuxt"><!--[--><div id="top" class="site library-site" data-v-7c241740 data-v-e230b581><a class="skip-link" href="#main" data-v-e230b581>Skip to content</a><header class="site-header" data-v-e230b581><div class="shell site-header__inner"><a href="/" class="brand" aria-label="StackOS home"><img src="/images/stackos-icon.png" alt width="36" height="36"><span>StackOS</span><small>Work, organized</small></a><nav class="site-nav site-nav--desktop" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav><details class="mobile-menu"><summary role="button" aria-label="Toggle navigation" aria-controls="site-navigation"><span></span><span></span></summary><nav id="site-navigation" class="site-nav site-nav--mobile" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav></details></div></header><div class="library-nav" aria-label="Library sections" data-v-e230b581><div class="shell library-nav__inner" data-v-e230b581><a href="/library/" class="" data-v-e230b581>Library</a><a href="/library/workflows/" class="" data-v-e230b581>Workflows</a><a href="/library/agents/" class="" data-v-e230b581>Agents</a><a href="/library/orchestrators/" class="" data-v-e230b581>Orchestrators</a><a href="/library/integrations/" class="" data-v-e230b581>Integrations</a><a href="/library/articles/" class="" data-v-e230b581>Articles</a></div></div><main id="main" class="library-main" data-v-e230b581><nav class="library-breadcrumbs" aria-label="Breadcrumb" data-v-e230b581 data-v-59391fa3><div class="shell" data-v-59391fa3><ol data-v-59391fa3><!--[--><li data-v-59391fa3><a href="/" class="" data-v-59391fa3>Home</a></li><li data-v-59391fa3><a href="/library/" class="" data-v-59391fa3>Library</a></li><li data-v-59391fa3><a href="/library/workflows/" class="" data-v-59391fa3>Workflows</a></li><li data-v-59391fa3><a aria-current="page" href="/library/workflows/gtm-account-research/" class="router-link-active router-link-exact-active" data-v-59391fa3>GTM Account Research</a></li><!--]--></ol></div></nav><!--[--><section class="detail-hero" data-v-7c241740><div class="shell detail-hero__grid" data-v-7c241740><div data-v-7c241740><p class="library-kicker" data-v-7c241740>Sales and go-to-market teams researching target accounts / gtm</p><h1 data-v-7c241740>GTM Account Research</h1><p class="detail-hero__lede" data-v-7c241740>A source-linked account brief focused on fit, timing, risks, and the next useful action.</p><div class="detail-tags" data-v-7c241740><span data-v-7c241740>4 stages</span><span data-v-7c241740>2 specialist agents</span><span data-v-7c241740>Depends on the selected path</span></div></div><div class="generated-visual generated-visual--workflow detail-hero__visual" style="--visual-color:#d9ff63;" role="img" aria-label="A complete plan you can follow. GTM Account Research. From request to result." data-v-7c241740 data-v-9361e887><header class="generated-visual__header" data-v-9361e887><div data-v-9361e887><span data-v-9361e887>From request to result</span><strong data-v-9361e887>A complete plan you can follow.</strong></div><small data-v-9361e887>Visible plan</small></header><div class="generated-visual__lane" aria-hidden="true" data-v-9361e887><div class="visual-node visual-node--clients" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Start in your AI</span><div class="client-list" data-v-9361e887><!--[--><span class="client-chip" data-v-9361e887><img src="/images/openai.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Codex</b></span><span class="client-chip" data-v-9361e887><img src="/images/claude.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Claude</b></span><span class="client-chip" data-v-9361e887><img src="/images/gemini.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Gemini</b></span><!--]--></div></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--stackos" data-v-9361e887><img src="/images/stackos-icon.png" alt="" width="42" height="42" loading="lazy" decoding="async" data-v-9361e887><strong data-v-9361e887>StackOS</strong><small data-v-9361e887>Builds the plan</small></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--outcome" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Visible stages</span><div class="outcome-list" data-v-9361e887><!--[--><span data-v-9361e887><b data-v-9361e887>1</b> Plan</span><span data-v-9361e887><b data-v-9361e887>2</b> Do</span><span data-v-9361e887><b data-v-9361e887>3</b> Check</span><!--]--></div></div></div></div></div></section><section class="detail-body" data-v-7c241740><div class="detail-body__narrow" data-v-7c241740><p class="eyebrow" data-v-7c241740>The problem</p><h2 data-v-7c241740>Account research often becomes a generic company summary that does not help someone make a real go-to-market decision.</h2><p class="detail-body__intro" data-v-7c241740>AI can combine stored account context with bounded current research while preserving source and confidence distinctions.</p></div><div class="shell experience-grid" data-v-7c241740><article data-v-7c241740><p class="eyebrow eyebrow--dark" data-v-7c241740>What you do</p><ol data-v-7c241740><!--[--><li data-v-7c241740>Name the account, offer, audience, and decision the brief should support.</li><li data-v-7c241740>Choose approved internal and web sources.</li><li data-v-7c241740>Review uncertain findings before they become outreach claims.</li><!--]--></ol></article><article data-v-7c241740><p class="eyebrow eyebrow--dark" data-v-7c241740>What the agent does</p><ol data-v-7c241740><!--[--><li data-v-7c241740>Load existing account and project context before external research.</li><li data-v-7c241740>Research only the missing decision-relevant facts and retain source refs.</li><li data-v-7c241740>Separate observations, inferences, gaps, and recommended next actions.</li><!--]--></ol></article></div><div class="detail-body__narrow detail-space" data-v-7c241740><p class="eyebrow" data-v-7c241740>When this workflow helps</p><h2 data-v-7c241740>A reusable method, adapted to the request.</h2><ul class="detail-list" data-v-7c241740><!--[--><li data-v-7c241740>A project needs account or company research before enrichment, outbound, CRM updates, or pipeline review.</li><li data-v-7c241740>The agent should reuse prior account context and learnings before collecting more evidence.</li><!--]--></ul></div><div class="shell readiness-grid" data-v-7c241740><article data-v-7c241740><p class="eyebrow eyebrow--dark" data-v-7c241740>Before it starts</p><h3 data-v-7c241740>Depends on the selected path</h3><ul data-v-7c241740><!--[--><li data-v-7c241740>A named account and decision to support</li><li data-v-7c241740>Offer and fit criteria</li><li data-v-7c241740>Approved internal and external research sources</li><!--]--></ul></article><article data-v-7c241740><p class="eyebrow eyebrow--dark" data-v-7c241740>What proves it worked</p><h3 data-v-7c241740>Evidence, not a success claim.</h3><ul data-v-7c241740><!--[--><li data-v-7c241740>Source-linked findings</li><li data-v-7c241740>Fit and risk assessment</li><li data-v-7c241740>Open questions and recommended next action</li><!--]--></ul></article></div><div class="shell workflow-showcase" data-v-7c241740><div class="library-section__heading" data-v-7c241740><div data-v-7c241740><p class="eyebrow" data-v-7c241740>Workflow path</p><h2 data-v-7c241740>The reusable stages of the work.</h2></div><p data-v-7c241740>A real run expands these stages around the request, context, selected tools, approvals, and dependencies.</p></div><section class="workflow-map" style="--workflow-color:#ff9f73;" aria-labelledby="workflow-map-title" data-v-7c241740 data-v-110563eb><header data-v-110563eb><span class="status-dot" data-v-110563eb></span><strong id="workflow-map-title" data-v-110563eb>4 ordered workflow stages</strong></header><ol aria-label="Workflow stages" data-v-110563eb><!--[--><li data-workflow-stage data-v-110563eb><span data-v-110563eb>01</span><div data-v-110563eb><h3 data-v-110563eb>Orient From Account History</h3><p data-v-110563eb>Read existing records, learnings, decisions, and the current research goal.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>02</span><div data-v-110563eb><h3 data-v-110563eb>Collect Evidence</h3><p data-v-110563eb>Use granted retrieval actions only for evidence gaps the agent identifies.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>03</span><div data-v-110563eb><h3 data-v-110563eb>Store Research</h3><p data-v-110563eb>Persist reviewed account, company, and contact context with provenance.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>04</span><div data-v-110563eb><h3 data-v-110563eb>Capture Learning</h3><p data-v-110563eb>Record reusable GTM lessons only when evidence is explicit.</p></div><small data-v-110563eb>Verified outcome</small></li><!--]--></ol></section></div><div class="detail-body__narrow" style="margin-top:88px;" data-v-7c241740><!--[--><p class="eyebrow" data-v-7c241740>Safe stopping and recovery</p><h2 data-v-7c241740>Useful even when the whole path cannot run.</h2><ul class="detail-list" data-v-7c241740><!--[--><li data-v-7c241740>Stop after the research brief; outreach requires a separate workflow and approval.</li><!--]--><!--[--><li data-v-7c241740>If entity identity is ambiguous, stop before merging sources.</li><li data-v-7c241740>If live research is unavailable, return a useful stored-context brief with explicit gaps.</li><!--]--></ul><!--]--><!--[--><p class="eyebrow detail-space" data-v-7c241740>Documented follow-on work</p><h2 data-v-7c241740>The next workflow is conditional, not hidden.</h2><div class="handoff-list" data-v-7c241740><!--[--><a href="/library/workflows/gtm-outbound-sequence-preparation/" class="" data-v-7c241740><span data-v-7c241740>conditional</span><strong data-v-7c241740>GTM Outbound Sequence Preparation</strong><p data-v-7c241740>The account is qualified and approved for outreach.</p></a><!--]--></div><!--]--><!--[--><p class="eyebrow detail-space" data-v-7c241740>Specialists inside this workflow</p><h2 data-v-7c241740>Clear roles for each part of the job.</h2><div class="detail-link-grid" data-v-7c241740><!--[--><a href="/library/agents/gtm-workflow-account-research/" class="" data-v-7c241740><span data-v-7c241740>Agent</span><strong data-v-7c241740>GTM Account Research Agent</strong><b aria-hidden="true" data-v-7c241740>→</b></a><a href="/library/agents/stackos-sdlc-delivery-reviewer/" class="" data-v-7c241740><span data-v-7c241740>Agent</span><strong data-v-7c241740>Review Agent</strong><b aria-hidden="true" data-v-7c241740>→</b></a><!--]--></div><!--]--><!--[--><p class="eyebrow detail-space" data-v-7c241740>Connected work</p><h2 data-v-7c241740>Built to use the tools you already have.</h2><div class="detail-tags detail-tags--paper" data-v-7c241740><!--[--><span data-v-7c241740>Jina</span><span data-v-7c241740>Firecrawl</span><!--]--></div><!--]--></div></section><section class="related-section" data-v-7c241740><div class="shell" data-v-7c241740><div class="library-section__heading" data-v-7c241740><div data-v-7c241740><p class="eyebrow eyebrow--dark" data-v-7c241740>Keep exploring</p><h2 data-v-7c241740>Related workflows.</h2></div><a href="/library/workflows/" class="" data-v-7c241740>See all 36 →</a></div><div class="library-grid" data-v-7c241740><!--[--><a href="/library/workflows/gtm-crm-export-handoff/" class="catalog-card" style="--card-color:#ff9f73;" data-v-7c241740 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM CRM Export Handoff</h3><p data-v-661e3dea>One approved bounded export with a safe job ref, a retained StackOS artifact when complete, and truthful pending, partial, or failed evidence.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>4 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/workflows/gtm-crm-hygiene-pass/" class="catalog-card" style="--card-color:#ff9f73;" data-v-7c241740 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM CRM Hygiene Pass</h3><p data-v-661e3dea>A reviewed hygiene report with narrowly approved corrections and an audit of every changed record.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>3 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/workflows/gtm-customer-follow-up/" class="catalog-card" style="--card-color:#ff9f73;" data-v-7c241740 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM Customer Follow-Up</h3><p data-v-661e3dea>One approved message delivered through an exact communication target, with full provider-safe evidence and separately approved CRM follow-up records.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>5 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><!--]--></div></div></section><!--]--></main><footer class="site-footer" data-v-e230b581 data-v-5f58f905><div class="shell site-footer__grid" data-v-5f58f905><a href="/" class="footer-brand" data-v-5f58f905><img src="/images/stackos-icon.png" alt width="42" height="42" loading="lazy" decoding="async" data-v-5f58f905><div data-v-5f58f905><strong data-v-5f58f905>StackOS</strong><span data-v-5f58f905>Keep AI-powered work clear, connected, and moving.</span></div></a><div class="site-footer__links" data-v-5f58f905><div data-v-5f58f905><span data-v-5f58f905>Explore</span><a href="/#why" class="" data-v-5f58f905>Why StackOS</a><a href="/getting-started/" class="" data-v-5f58f905>Getting started</a><a href="/library/" class="" data-v-5f58f905>Library</a><a href="/library/workflows/" class="" data-v-5f58f905>Workflows</a><a href="/library/articles/" class="" data-v-5f58f905>Articles</a></div><div data-v-5f58f905><span data-v-5f58f905>Build</span><a href="/#security" class="" data-v-5f58f905>Security</a><a href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac" data-v-5f58f905>Download</a><a href="https://github.com/flowmonkeyio/StackOS