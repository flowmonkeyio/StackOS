preload" as="script" crossorigin href="/_nuxt/Df8p5hZf.js"><script type="module" src="/_nuxt/CHhb2Wy-.js" crossorigin></script><link rel="icon" type="image/png" href="/images/stackos-icon.png"><link rel="apple-touch-icon" href="/images/stackos-icon.png"><link rel="alternate" type="application/rss+xml" title="StackOS Library" href="/feed.xml"><meta name="description" content="Explore 52 bounded AI agent roles for research, planning, creation, review, and verification, each with a clear context, tool, output, and handoff contract."><meta name="theme-color" content="#090b10"><meta property="og:type" content="website"><meta property="og:title" content="AI agents for business — 52 specialist roles | StackOS"><meta property="og:description" content="Explore 52 bounded AI agent roles for research, planning, creation, review, and verification, each with a clear context, tool, output, and handoff contract."><meta name="twitter:title" content="AI agents for business — 52 specialist roles | StackOS"><meta name="twitter:description" content="Explore 52 bounded AI agent roles for research, planning, creation, review, and verification, each with a clear context, tool, output, and handoff contract."><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"><link rel="canonical" href="https://stackos.flowmonkey.io/library/agents/"><meta property="og:url" content="https://stackos.flowmonkey.io/library/agents/"><script type="application/ld+json" data-hid="agent-library-faq">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What are AI agents for business?","acceptedAnswer":{"@type":"Answer","text":"An AI agent for business is a model operating under a role contract for one bounded responsibility. The contract defines relevant context, tools, authority, output, recovery, and when control returns to the orchestrator."}}]}</script><meta property="og:site_name" content="StackOS"><script id="unhead:payload" type="application/json">{"titleTemplate":"%s | StackOS"}</script></head><body><div id="__nuxt"><!--[--><div id="top" class="site library-site" data-v-e230b581><a class="skip-link" href="#main" data-v-e230b581>Skip to content</a><header class="site-header" data-v-e230b581><div class="shell site-header__inner"><a href="/" class="brand" aria-label="StackOS home"><img src="/images/stackos-icon.png" alt width="36" height="36"><span>StackOS</span><small>Work, organized</small></a><nav class="site-nav site-nav--desktop" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav><details class="mobile-menu"><summary role="button" aria-label="Toggle navigation" aria-controls="site-navigation"><span></span><span></span></summary><nav id="site-navigation" class="site-nav site-nav--mobile" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav></details></div></header><div class="library-nav" aria-label="Library sections" data-v-e230b581><div class="shell library-nav__inner" data-v-e230b581><a href="/library/" class="" data-v-e230b581>Library</a><a href="/library/workflows/" class="" data-v-e230b581>Workflows</a><a aria-current="page" href="/library/agents/" class="router-link-active router-link-exact-active" data-v-e230b581>Agents</a><a href="/library/orchestrators/" class="" data-v-e230b581>Orchestrators</a><a href="/library/integrations/" class="" data-v-e230b581>Integrations</a><a href="/library/articles/" class="" data-v-e230b581>Articles</a></div></div><main id="main" class="library-main" data-v-e230b581><nav class="library-breadcrumbs" aria-label="Breadcrumb" data-v-e230b581 data-v-59391fa3><div class="shell" data-v-59391fa3><ol data-v-59391fa3><!--[--><li data-v-59391fa3><a href="/" class="" data-v-59391fa3>Home</a></li><li data-v-59391fa3><a href="/library/" class="" data-v-59391fa3>Library</a></li><li data-v-59391fa3><a aria-current="page" href="/library/agents/" class="router-link-active router-link-exact-active" data-v-59391fa3>Agents</a></li><!--]--></ol></div></nav><!--[--><!--[--><section class="catalog-hero library-collection-hero" data-v-1228b120 data-v-f4278edf><div class="shell library-collection-hero__layout" data-v-f4278edf><div class="library-collection-hero__copy" data-v-f4278edf><p class="library-kicker" data-v-f4278edf>StackOS Library / agents</p><h1 data-v-f4278edf>Specialist agents with <em data-v-f4278edf>clear jobs.</em></h1><p class="catalog-hero__lede" data-v-f4278edf>Each agent owns one bounded responsibility inside a larger workflow, with its context, tools, output, and handoff made explicit.</p><div class="catalog-hero__meta" data-v-f4278edf><!--[--><span data-v-1228b120>52 in the library</span><span data-v-1228b120>11 areas of work</span><span data-v-1228b120>Based on real StackOS workflows</span><!--]--></div></div><!----></div></section><section class="catalog-answer" aria-labelledby="catalog-answer-title" data-v-1228b120><div class="shell catalog-answer__grid" data-v-1228b120><div class="catalog-answer__copy" data-v-1228b120><p class="eyebrow" data-v-1228b120>Quick answer</p><h2 id="catalog-answer-title" data-v-1228b120>What are AI agents for business?</h2><p data-v-1228b120>An AI agent is a model operating under a role contract for one bounded responsibility. The contract defines the context and tools it receives, the result it must return, how it recovers, and when control goes back to the orchestrator.</p><a href="/library/articles/ai-agent-vs-workflow-vs-orchestrator/" class="" data-v-1228b120>Compare agents, workflows, and orchestrators → </a></div><div class="catalog-answer__points" data-v-1228b120><!--[--><article data-v-1228b120><span data-v-1228b120>Bounded role</span><p data-v-1228b120>One responsibility with a clear result and authority boundary.</p></article><article data-v-1228b120><span data-v-1228b120>Executable packet</span><p data-v-1228b120>Relevant context, tools, acceptance criteria, and recovery.</p></article><article data-v-1228b120><span data-v-1228b120>Reasoned handoff</span><p data-v-1228b120>Returns the result and rationale without taking over the whole workflow.</p></article><!--]--></div></div></section><!--[--><!--]--><section class="catalog-list" data-v-1228b120><div class="shell" data-v-1228b120><div class="catalog-filter" aria-label="Filter by area" data-v-1228b120><!--[--><button type="button" class="is-active" data-v-1228b120>All areas</button><button type="button" class="" data-v-1228b120>engineering</button><button type="button" class="" data-v-1228b120>branding</button><button type="button" class="" data-v-1228b120>marketing</button><button type="button" class="" data-v-1228b120>communications</button><button type="button" class="" data-v-1228b120>finance</button><button type="button" class="" data-v-1228b120>gtm</button><button type="button" class="" data-v-1228b120>media buying</button><button type="button" class="" data-v-1228b120>core</button><button type="button" class="" data-v-1228b120>seo</button><button type="button" class="" data-v-1228b120>support</button><button type="button" class="" data-v-1228b120>trackbooth</button><!--]--></div><div class="library-grid" data-v-1228b120><!--[--><a href="/library/agents/stackos-sdlc-architecture/" class="catalog-card" style="--card-color:#7892ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>engineering</b></div><h3 data-v-661e3dea>Architecture Agent</h3><p data-v-661e3dea>Defines the project-native candidate design, ownership boundaries, interfaces, risks, and proof obligations before ticket breakdown.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/branding-profile-architect/" class="catalog-card" style="--card-color:#d8ff63;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>branding</b></div><h3 data-v-661e3dea>Brand Profile Architect</h3><p data-v-661e3dea>Builds and maintains evidence-led brand profiles and durable voice guides from operator judgment, representative samples, and independent review.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/branding-channel-strategist/" class="catalog-card" style="--card-color:#d8ff63;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>branding</b></div><h3 data-v-661e3dea>Branding Channel Strategist</h3><p data-v-661e3dea>Owns angle, structure, and channel publication job decisions without executing publication.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/branding-claim-auditor/" class="catalog-card" style="--card-color:#d8ff63;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>branding</b></div><h3 data-v-661e3dea>Branding Claim Auditor</h3><p data-v-661e3dea>Read-only adversarial reviewer that enforces evidence-over-assertion.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>review role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/branding-evidence-curator/" class="catalog-card" style="--card-color:#d8ff63;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>branding</b></div><h3 data-v-661e3dea>Branding Evidence Curator</h3><p data-v-661e3dea>Conditionally interviews, researches, and captures operational receipts when dedicated evidence lineage is warranted.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/branding-narrative-writer/" class="catalog-card" style="--card-color:#d8ff63;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>branding</b></div><h3 data-v-661e3dea>Branding Narrative Writer</h3><p data-v-661e3dea>Drafts canonical pieces and channel renditions from cleared evidence in the project-adapted voice.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/branding-sanitization-reviewer/" class="catalog-card" style="--card-color:#d8ff63;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>branding</b></div><h3 data-v-661e3dea>Branding Sanitization Reviewer</h3><p data-v-661e3dea>Read-only disclosure reviewer that fails closed with cleared or blocked verdicts.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>review role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/branding-voice-reviewer/" class="catalog-card" style="--card-color:#d8ff63;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>branding</b></div><h3 data-v-661e3dea>Branding Voice Reviewer</h3><p data-v-661e3dea>Read-only reviewer for base voice, channel register delta, form contract, and kill tests.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>review role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/marketing-campaign-brief-analyst/" class="catalog-card" style="--card-color:#ff78ac;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>marketing</b></div><h3 data-v-661e3dea>Campaign Brief Analyst</h3><p data-v-661e3dea>Converts raw operator inputs into a complete, professional campaign brief resource with persisted input artifacts and a proposed campaign workspace slug.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/marketing-campaign-creative-director/" class="catalog-card" style="--card-color:#ff78ac;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>marketing</b></div><h3 data-v-661e3dea>Campaign Creative Director</h3><p data-v-661e3dea>Turns the approved brief into the campaign plan whose media manifest, page plans, and acceptance criteria form the traceability contract for production and signoff.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/marketing-campaign-landing-page-builder/" class="catalog-card" style="--card-color:#ff78ac;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>marketing</b></div><h3 data-v-661e3dea>Campaign Landing Page Builder</h3><p data-v-661e3dea>Builds each planned landing page variant as a self-contained static HTML file in the campaign workspace and assembles gallery.html as the operator-facing index.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/marketing-campaign-media-producer/" class="catalog-card" style="--card-color:#ff78ac;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>marketing</b></div><h3 data-v-661e3dea>Campaign Media Producer</h3><p data-v-661e3dea>Executes approved image manifest entries through granted generation actions with drift control, set consistency, cost discipline, and truthful per-asset records; video requests are…</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/marketing-campaign-visual-signoff-reviewer/" class="catalog-card" style="--card-color:#ff78ac;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>marketing</b></div><h3 data-v-661e3dea>Campaign Visual Signoff Reviewer</h3><p data-v-661e3dea>Verifies every produced asset and page against the approved campaign plan&#39;s acceptance criteria with rendered evidence and per-item verdicts instead of rubber stamps.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>review role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-sdlc-codebase-explorer/" class="catalog-card" style="--card-color:#7892ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>engineering</b></div><h3 data-v-661e3dea>Codebase Explorer</h3><p data-v-661e3dea>Maps actual execution paths, owners, consumers, coupling, and proof surfaces for a bounded assignment.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/communications-workflow-callback-follow-up/" class="catalog-card" style="--card-color:#7ee2ad;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>communications</b></div><h3 data-v-661e3dea>Communications Callback Follow-Up Agent</h3><p data-v-661e3dea>Handles callback or follow-up requests with origin context, route policy, and reply/send safety.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/communications-workflow-customer-feedback-intake/" class="catalog-card" style="--card-color:#7ee2ad;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>communications</b></div><h3 data-v-661e3dea>Communications Customer Feedback Intake Agent</h3><p data-v-661e3dea>Normalizes customer feedback from Slack, Telegram, or another channel into one route-approved canonical Slack support thread while preserving media and handoff refs.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/communications-workflow-inbox-review/" class="catalog-card" style="--card-color:#7ee2ad;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>communications</b></div><h3 data-v-661e3dea>Communications Inbox Review Agent</h3><p data-v-661e3dea>Reviews stored inbound communications, triages requests, and prepares safe workflow or reply handoffs.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/communications-workflow-outbound-notification/" class="catalog-card" style="--card-color:#7ee2ad;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>communications</b></div><h3 data-v-661e3dea>Communications Outbound Notification Agent</h3><p data-v-661e3dea>Prepares and sends explicit provider-neutral outbound notifications through named targets.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/communications-workflow-rich-telegram-reply/" class="catalog-card" style="--card-color:#7ee2ad;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>communications</b></div><h3 data-v-661e3dea>Communications Rich Telegram Reply Agent</h3><p data-v-661e3dea>Sends or validates Telegram replies with rich features while preserving exact delivery semantics.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-sdlc-delivery/" class="catalog-card" style="--card-color:#7892ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>engineering</b></div><h3 data-v-661e3dea>Delivery Agent</h3><p data-v-661e3dea>Implements one assigned ticket, performs its self-checks and bounded repairs, and returns candidate-ready evidence for immediate independent review.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-finance-billing-collections-operator/" class="catalog-card" style="--card-color:#8ea6ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>finance</b></div><h3 data-v-661e3dea>Finance Billing and Collections Operator</h3><p data-v-661e3dea>Handles Stripe billing, agent-authored email follow-ups and received-payment settlement from operator instructions or documented settings, with current-state and recovery checks.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-finance-bookkeeping-preparer/" class="catalog-card" style="--card-color:#8ea6ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>finance</b></div><h3 data-v-661e3dea>Finance Bookkeeping Preparer</h3><p data-v-661e3dea>Prepares source-complete close and reconciliation packets in the selected external finance backend without posting or deciding accounting treatment.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-finance-cashflow-preparer/" class="catalog-card" style="--card-color:#8ea6ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>finance</b></div><h3 data-v-661e3dea>Finance Cashflow Preparer</h3><p data-v-661e3dea>Prepares a dated external cashflow packet, including separate scenarios and an explicitly reviewed tax-reserve input.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-finance-control-reviewer/" class="catalog-card" style="--card-color:#8ea6ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>finance</b></div><h3 data-v-661e3dea>Finance Control Reviewer</h3><p data-v-661e3dea>Independently reviews source completeness, external-record concurrency proof, action audit, and approval boundaries without changing records or approving itself.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>review role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-finance-receipt-operator/" class="catalog-card" style="--card-color:#8ea6ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>finance</b></div><h3 data-v-661e3dea>Finance Receipt Operator</h3><p data-v-661e3dea>Mechanically stages receipt evidence into the selected external finance backend and prepares an evidence packet without deciding accounting treatment.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-finance-tax-preparer/" class="catalog-card" style="--card-color:#8ea6ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>finance</b></div><h3 data-v-661e3dea>Finance Tax Preparer</h3><p data-v-661e3dea>Prepares a current-source tax-estimate packet and obligation matrix for review without giving advice, filing, paying, or remitting.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/gtm-workflow-account-research/" class="catalog-card" style="--card-color:#ff9f73;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM Account Research Agent</h3><p data-v-661e3dea>Produces account research briefs with source clarity, ICP fit, risks, and outreach-ready handoff.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/gtm-workflow-crm-export-handoff/" class="catalog-card" style="--card-color:#ff9f73;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM CRM Export Handoff Agent</h3><p data-v-661e3dea>Validates one bounded HubSpot export and reconciles its async job, managed artifact, and retention evidence.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/gtm-workflow-crm-hygiene-pass/" class="catalog-card" style="--card-color:#ff9f73;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM CRM Hygiene Agent</h3><p data-v-661e3dea>Plans and reviews CRM cleanup with field-level atomic updates, duplicates, and audit visibility.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/gtm-workflow-customer-follow-up/" class="catalog-card" style="--card-color:#ff9f73;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM Customer Follow-Up Agent</h3><p data-v-661e3dea>Sends one approved HubSpot transactional follow-up through the canonical communication target and optionally records CRM activity.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/gtm-workflow-lead-enrichment-scoring/" class="catalog-card" style="--card-color:#ff9f73;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM Lead Enrichment Scoring Agent</h3><p data-v-661e3dea>Enriches and scores leads according to project-specific fields, confidence, and review policy.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/gtm-workflow-marketing-program-lifecycle/" class="catalog-card" style="--card-color:#ff9f73;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM Marketing Program Lifecycle Agent</h3><p data-v-661e3dea>Reviews and applies bounded HubSpot audience, campaign, draft-email, and consent changes with separate risk gates.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/gtm-workflow-outbound-sequence-preparation/" class="catalog-card" style="--card-color:#ff9f73;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM Outbound Sequence Agent</h3><p data-v-661e3dea>Prepares outbound sequence content and targeting with research, compliance, and approval context.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/gtm-workflow-pipeline-risk-review/" class="catalog-card" style="--card-color:#ff9f73;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>gtm</b></div><h3 data-v-661e3dea>GTM Pipeline Risk Review Agent</h3><p data-v-661e3dea>Reviews pipeline risk, stale opportunities, and next actions using CRM context and project-specific stage rules.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/media-buying-workflow-landing-page-creative-experiment/" class="catalog-card" style="--card-color:#ffbd5c;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>media buying</b></div><h3 data-v-661e3dea>Landing Page Creative Experiment Agent</h3><p data-v-661e3dea>Coordinates landing-page and creative experiment planning across UX, media, tracking, and review.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/media-buying-workflow-budget-reallocation-review/" class="catalog-card" style="--card-color:#ffbd5c;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>media buying</b></div><h3 data-v-661e3dea>Media Budget Reallocation Agent</h3><p data-v-661e3dea>Reviews budget movement proposals with evidence, constraints, and approval awareness.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/media-buying-workflow-campaign-launch/" class="catalog-card" style="--card-color:#ffbd5c;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>media buying</b></div><h3 data-v-661e3dea>Media Campaign Launch Agent</h3><p data-v-661e3dea>Prepares paid media campaign launches with explicit assumptions, approvals, and provider-action boundaries.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/media-buying-workflow-creative-variant-generation/" class="catalog-card" style="--card-color:#ffbd5c;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>media buying</b></div><h3 data-v-661e3dea>Media Creative Variant Agent</h3><p data-v-661e3dea>Generates and reviews creative variant plans tied to hypothesis, brand constraints, and measurement.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/media-buying-workflow-performance-diagnosis/" class="catalog-card" style="--card-color:#ffbd5c;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>media buying</b></div><h3 data-v-661e3dea>Media Performance Diagnosis Agent</h3><p data-v-661e3dea>Diagnoses media performance using bounded evidence, live-data caveats, and prioritized next checks.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-sdlc-planning/" class="catalog-card" style="--card-color:#7892ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>engineering</b></div><h3 data-v-661e3dea>Planning Agent</h3><p data-v-661e3dea>Turns requirements, selected design, and proof plan into independently executable ticket packets and a coherent dependency graph.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-workflow-project-memory-review/" class="catalog-card" style="--card-color:#8ea6ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>core</b></div><h3 data-v-661e3dea>Project Memory Review Agent</h3><p data-v-661e3dea>Reviews bounded StackOS project memory and prepares a grounded next-step recommendation.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-sdlc-release-ops/" class="catalog-card" style="--card-color:#7892ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>engineering</b></div><h3 data-v-661e3dea>Release/Ops Agent</h3><p data-v-661e3dea>Handles release readiness, rollout notes, post-release checks, and operational cleanup.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-sdlc-requirements-flow-definer/" class="catalog-card" style="--card-color:#7892ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>engineering</b></div><h3 data-v-661e3dea>Requirements Flow Definer</h3><p data-v-661e3dea>Defines traceable project-specific requirements, user/data/system/business flows, and acceptance criteria before design.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-sdlc-delivery-reviewer/" class="catalog-card" style="--card-color:#7892ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>engineering</b></div><h3 data-v-661e3dea>Review Agent</h3><p data-v-661e3dea>Independently reviews assigned readiness, ticket, integration, or audit scope against canonical requirements and actual evidence, returning findings for main-agent adjudication.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>review role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/seo-workflow-content-refresh/" class="catalog-card" style="--card-color:#79dfff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>seo</b></div><h3 data-v-661e3dea>SEO Content Refresh Agent</h3><p data-v-661e3dea>Prepares, reviews, applies when authorized, and later assesses bounded content and internal-link improvements with comparable evidence and per-edit receipts.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/seo-workflow-keyword-research/" class="catalog-card" style="--card-color:#79dfff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>seo</b></div><h3 data-v-661e3dea>SEO Keyword Research Agent</h3><p data-v-661e3dea>Qualifies search opportunities against reader intent, business fit, existing pages, and durable evidence before recommending action.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/support-workflow-delivery-handoff/" class="catalog-card" style="--card-color:#a8e37f;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>support</b></div><h3 data-v-661e3dea>Support Delivery Handoff Agent</h3><p data-v-661e3dea>Converts a support conclusion and same-thread operator instruction into delivery-ready tracker work with durable chat refs.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/support-workflow-issue-investigator/" class="catalog-card" style="--card-color:#a8e37f;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>support</b></div><h3 data-v-661e3dea>Support Issue Investigator</h3><p data-v-661e3dea>Investigates the full canonical support thread and project evidence, asks bounded clarification questions, and posts a thread-bound conclusion without implementing fixes.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-sdlc-test-designer/" class="catalog-card" style="--card-color:#7892ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>engineering</b></div><h3 data-v-661e3dea>Test Designer</h3><p data-v-661e3dea>Allocates requirements and design risks to ticket-local and integration proof with concrete commands, scenarios, authority, and expected evidence.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/trackbooth-agent-api-operator/" class="catalog-card" style="--card-color:#8ea6ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>trackbooth</b></div><h3 data-v-661e3dea>Trackbooth Agent API Operator</h3><p data-v-661e3dea>Operates Trackbooth Agent API inventory only through StackOS manual catalog sync, generated actions, and daemon-held API-key auth.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>mechanical role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/seo-workflow-website-analysis/" class="catalog-card" style="--card-color:#79dfff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>seo</b></div><h3 data-v-661e3dea>Website SEO Analysis Agent</h3><p data-v-661e3dea>Maps a website, reconciles public and connected evidence, and produces one independently reviewed finding register and prioritized roadmap without inventing measurements.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/agents/stackos-workflow-workflow-author/" class="catalog-card" style="--card-color:#8ea6ff;" data-v-1228b120 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span class="catalog-card__agent" data-v-661e3dea>A</span><i class="catalog-card__orbit" data-v-661e3dea></i><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>agent</span><b data-v-661e3dea>core</b></div><h3 data-v-661e3dea>Workflow Author</h3><p data-v-661e3dea>Designs reusable StackOS workflow contracts, project workflow extensions, and concrete run plans from project-safe context.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>reasoning role</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><!--]--></div></div></section><!--]--><!--]--></main><footer class="site-footer" data-v-e230b581 data-v-5f58f905><div class="shell site-footer__grid" data-v-5f58f905><a href="/" class="footer-brand" data-v-5f58f905><img src="/images/stackos-icon.png" alt width="42" height="42" loading="lazy" decoding="async" data-v-5f58f905><div data-v-5f58f905><strong data-v-5f58f905>StackOS</strong><span data-v-5f58f905>Keep AI-powered work clear, connected, and moving.</span></div></a><div class="site-footer__links" data-v-5f58f905><div data-v-5f58f905><span data-v-5f58f905>Explore</span><a href="/#why" class="" data-v-5f58f905>Why StackOS</a><a href="/getting-started/" class="" data-v-5f58f905>Getting started</a><a href="/library/" class="" data-v-5f58f905>Library</a><a href="/library/workflows/" class="" data-v-5f58f905>Workflows</a><a href="/library/articles/" class="" data-v-5f58f905>Articles</a></div><div data-v-5f58f905><span data-v-5f58f905>Build</span><a href="/#security" class="" data-v-5f58f905>Security</a><a href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac" data-v-5f58f905>Download</a><a href="https://github.com/flowmonkeyio/StackOS" target="_blank" rel="noreferrer" data-v-5f58f905>GitHub ↗</a></div></div><div class="site-footer__status" data-v-5f58f905><span class="status-dot" data-v-5f58f905></span><div data-v-5f58f905><strong data-v-5f58f905>Runs on your Mac</strong><small data-v-5f58f905>Your work. Your apps. Your private logins.</small></div></div></div><div class="shell site-footer__bottom" data-v-5f58f905><span data-v-5f58f905>StackOS · Your AI tool works. StackOS keeps the work organized.</span><span data-v-5f58f905>Runs locally.</span></div></footer></div><!----><!--]--></div><div id="teleports"></div><scri