lepreload" as="script" crossorigin href="/_nuxt/B6FA65gX.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/Df8p5hZf.js"><script type="module" src="/_nuxt/CHhb2Wy-.js" crossorigin></script><link rel="icon" type="image/png" href="/images/stackos-icon.png"><link rel="apple-touch-icon" href="/images/stackos-icon.png"><link rel="alternate" type="application/rss+xml" title="StackOS Library" href="/feed.xml"><meta name="description" content="A bounded memory review that explains what the project knows, what remains uncertain, and the best next action."><meta name="theme-color" content="#090b10"><meta property="og:type" content="website"><meta property="og:title" content="Project Memory Review workflow | StackOS"><meta property="og:description" content="A bounded memory review that explains what the project knows, what remains uncertain, and the best next action."><meta name="twitter:title" content="Project Memory Review workflow | StackOS"><meta name="twitter:description" content="A bounded memory review that explains what the project knows, what remains uncertain, and the best next action."><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"><link rel="canonical" href="https://stackos.flowmonkey.io/library/workflows/core-project-memory-review/"><meta property="og:url" content="https://stackos.flowmonkey.io/library/workflows/core-project-memory-review/"><meta property="og:site_name" content="StackOS"><script id="unhead:payload" type="application/json">{"titleTemplate":"%s | StackOS"}</script></head><body><div id="__nuxt"><!--[--><div id="top" class="site library-site" data-v-7c241740 data-v-e230b581><a class="skip-link" href="#main" data-v-e230b581>Skip to content</a><header class="site-header" data-v-e230b581><div class="shell site-header__inner"><a href="/" class="brand" aria-label="StackOS home"><img src="/images/stackos-icon.png" alt width="36" height="36"><span>StackOS</span><small>Work, organized</small></a><nav class="site-nav site-nav--desktop" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav><details class="mobile-menu"><summary role="button" aria-label="Toggle navigation" aria-controls="site-navigation"><span></span><span></span></summary><nav id="site-navigation" class="site-nav site-nav--mobile" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav></details></div></header><div class="library-nav" aria-label="Library sections" data-v-e230b581><div class="shell library-nav__inner" data-v-e230b581><a href="/library/" class="" data-v-e230b581>Library</a><a href="/library/workflows/" class="" data-v-e230b581>Workflows</a><a href="/library/agents/" class="" data-v-e230b581>Agents</a><a href="/library/orchestrators/" class="" data-v-e230b581>Orchestrators</a><a href="/library/integrations/" class="" data-v-e230b581>Integrations</a><a href="/library/articles/" class="" data-v-e230b581>Articles</a></div></div><main id="main" class="library-main" data-v-e230b581><nav class="library-breadcrumbs" aria-label="Breadcrumb" data-v-e230b581 data-v-59391fa3><div class="shell" data-v-59391fa3><ol data-v-59391fa3><!--[--><li data-v-59391fa3><a href="/" class="" data-v-59391fa3>Home</a></li><li data-v-59391fa3><a href="/library/" class="" data-v-59391fa3>Library</a></li><li data-v-59391fa3><a href="/library/workflows/" class="" data-v-59391fa3>Workflows</a></li><li data-v-59391fa3><a aria-current="page" href="/library/workflows/core-project-memory-review/" class="router-link-active router-link-exact-active" data-v-59391fa3>Project Memory Review</a></li><!--]--></ol></div></nav><!--[--><section class="detail-hero" data-v-7c241740><div class="shell detail-hero__grid" data-v-7c241740><div data-v-7c241740><p class="library-kicker" data-v-7c241740>Any team resuming or orienting complex project work / core</p><h1 data-v-7c241740>Project Memory Review</h1><p class="detail-hero__lede" data-v-7c241740>A bounded memory review that explains what the project knows, what remains uncertain, and the best next action.</p><div class="detail-tags" data-v-7c241740><span data-v-7c241740>3 stages</span><span data-v-7c241740>2 specialist agents</span><span data-v-7c241740>Ready with project context</span></div></div><div class="generated-visual generated-visual--workflow detail-hero__visual" style="--visual-color:#d9ff63;" role="img" aria-label="A complete plan you can follow. Project Memory Review. From request to result." data-v-7c241740 data-v-9361e887><header class="generated-visual__header" data-v-9361e887><div data-v-9361e887><span data-v-9361e887>From request to result</span><strong data-v-9361e887>A complete plan you can follow.</strong></div><small data-v-9361e887>Visible plan</small></header><div class="generated-visual__lane" aria-hidden="true" data-v-9361e887><div class="visual-node visual-node--clients" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Start in your AI</span><div class="client-list" data-v-9361e887><!--[--><span class="client-chip" data-v-9361e887><img src="/images/openai.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Codex</b></span><span class="client-chip" data-v-9361e887><img src="/images/claude.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Claude</b></span><span class="client-chip" data-v-9361e887><img src="/images/gemini.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Gemini</b></span><!--]--></div></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--stackos" data-v-9361e887><img src="/images/stackos-icon.png" alt="" width="42" height="42" loading="lazy" decoding="async" data-v-9361e887><strong data-v-9361e887>StackOS</strong><small data-v-9361e887>Builds the plan</small></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--outcome" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Visible stages</span><div class="outcome-list" data-v-9361e887><!--[--><span data-v-9361e887><b data-v-9361e887>1</b> Plan</span><span data-v-9361e887><b data-v-9361e887>2</b> Do</span><span data-v-9361e887><b data-v-9361e887>3</b> Check</span><!--]--></div></div></div></div></div></section><section class="detail-body" data-v-7c241740><div class="detail-body__narrow" data-v-7c241740><p class="eyebrow" data-v-7c241740>The problem</p><h2 data-v-7c241740>Projects accumulate runs, decisions, evidence, and unfinished work faster than an agent can safely reconstruct from chat.</h2><p class="detail-body__intro" data-v-7c241740>AI can connect evidence across several project records while keeping source refs and uncertainty visible.</p></div><div class="shell experience-grid" data-v-7c241740><article data-v-7c241740><p class="eyebrow eyebrow--dark" data-v-7c241740>What you do</p><ol data-v-7c241740><!--[--><li data-v-7c241740>State the question or decision the memory review should support.</li><li data-v-7c241740>Confirm the project scope and desired persistence level.</li><li data-v-7c241740>Review the recommendation before starting any follow-up workflow.</li><!--]--></ol></article><article data-v-7c241740><p class="eyebrow eyebrow--dark" data-v-7c241740>What the agent does</p><ol data-v-7c241740><!--[--><li data-v-7c241740>Check active tracker and run-plan state first so the review does not ignore or duplicate current work.</li><li data-v-7c241740>Query only the relevant project sources and preserve their refs.</li><li data-v-7c241740>Separate facts, decisions, stale assumptions, contradictions, and gaps.</li><li data-v-7c241740>Return a recommendation or a concrete run-plan proposal without executing it implicitly.</li><!--]--></ol></article></div><div class="detail-body__narrow detail-space" data-v-7c241740><p class="eyebrow" data-v-7c241740>When this workflow helps</p><h2 data-v-7c241740>A reusable method, adapted to the request.</h2><ul class="detail-list" data-v-7c241740><!--[--><li data-v-7c241740>The agent needs to understand recent project history before planning work.</li><li data-v-7c241740>A workflow should start from prior runs, learnings, experiments, and decisions.</li><!--]--></ul></div><div class="shell readiness-grid" data-v-7c241740><article data-v-7c241740><p class="eyebrow eyebrow--dark" data-v-7c241740>Before it starts</p><h3 data-v-7c241740>Ready with project context</h3><ul data-v-7c241740><!--[--><li data-v-7c241740>A clear question or decision</li><li data-v-7c241740>An existing StackOS project with relevant stored context</li><!--]--></ul></article><article data-v-7c241740><p class="eyebrow eyebrow--dark" data-v-7c241740>What proves it worked</p><h3 data-v-7c241740>Evidence, not a success claim.</h3><ul data-v-7c241740><!--[--><li data-v-7c241740>Source-linked memory summary</li><li data-v-7c241740>Explicit gaps and conflicts</li><li data-v-7c241740>Recommended next action with rationale</li><!--]--></ul></article></div><div class="shell workflow-showcase" data-v-7c241740><div class="library-section__heading" data-v-7c241740><div data-v-7c241740><p class="eyebrow" data-v-7c241740>Workflow path</p><h2 data-v-7c241740>The reusable stages of the work.</h2></div><p data-v-7c241740>A real run expands these stages around the request, context, selected tools, approvals, and dependencies.</p></div><section class="workflow-map" style="--workflow-color:#8ea6ff;" aria-labelledby="workflow-map-title" data-v-7c241740 data-v-110563eb><header data-v-110563eb><span class="status-dot" data-v-110563eb></span><strong id="workflow-map-title" data-v-110563eb>3 ordered workflow stages</strong></header><ol aria-label="Workflow stages" data-v-110563eb><!--[--><li data-workflow-stage data-v-110563eb><span data-v-110563eb>01</span><div data-v-110563eb><h3 data-v-110563eb>Clarify Goal And Scope</h3><p data-v-110563eb>Restate the goal, assumptions, constraints, and missing inputs.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>02</span><div data-v-110563eb><h3 data-v-110563eb>Retrieve Bounded Context</h3><p data-v-110563eb>Query only the declared fields and limits before reasoning.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>03</span><div data-v-110563eb><h3 data-v-110563eb>Propose Next Plan</h3><p data-v-110563eb>Draft an agent-authored plan, explicit open questions, and any approval needs.</p></div><small data-v-110563eb>Verified outcome</small></li><!--]--></ol></section></div><div class="detail-body__narrow" style="margin-top:88px;" data-v-7c241740><!--[--><p class="eyebrow" data-v-7c241740>Safe stopping and recovery</p><h2 data-v-7c241740>Useful even when the whole path cannot run.</h2><ul class="detail-list" data-v-7c241740><!--[--><li data-v-7c241740>Stop after the recommendation unless the operator explicitly starts follow-up work.</li><!--]--><!--[--><li data-v-7c241740>If the project scope or source authority is unclear, stop with a bounded clarification.</li><li data-v-7c241740>If records conflict, present both and name the decision needed.</li><!--]--></ul><!--]--><!----><!--[--><p class="eyebrow detail-space" data-v-7c241740>Specialists inside this workflow</p><h2 data-v-7c241740>Clear roles for each part of the job.</h2><div class="detail-link-grid" data-v-7c241740><!--[--><a href="/library/agents/stackos-workflow-project-memory-review/" class="" data-v-7c241740><span data-v-7c241740>Agent</span><strong data-v-7c241740>Project Memory Review Agent</strong><b aria-hidden="true" data-v-7c241740>→</b></a><a href="/library/agents/stackos-sdlc-planning/" class="" data-v-7c241740><span data-v-7c241740>Agent</span><strong data-v-7c241740>Planning Agent</strong><b aria-hidden="true" data-v-7c241740>→</b></a><!--]--></div><!--]--><!----></div></section><!----><!--]--></main><footer class="site-footer" data-v-e230b581 data-v-5f58f905><div class="shell site-footer__grid" data-v-5f58f905><a href="/" class="footer-brand" data-v-5f58f905><img src="/images/stackos-icon.png" alt width="42" height="42" loading="lazy" decoding="async" data-v-5f58f905><div data-v-5f58f905><strong data-v-5f58f905>StackOS</strong><span data-v-5f58f905>Keep AI-powered work clear, connected, and moving.</span></div></a><div class="site-footer__links" data-v-5f58f905><div data-v-5f58f905><span data-v-5f58f905>Explore</span><a href="/#why" class="" data-v-5f58f905>Why StackOS</a><a href="/getting-started/" class="" data-v-5f58f905>Getting started</a><a href="/library/" class="" data-v-5f58f905>Library</a><a href="/library/workflows/" class="" data-v-5f58f905>Workflows</a><a href="/library/articles/" class="" data-v-5f58f905>Articles</a></div><div data-v-5f58f905><span data-v-5f58f905>Build</span><a href="/#security" class="" data-v-5f58f905>Security</a><a href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac" data-v-5f58f905>Download</a><a href="https://github.com/flowmonkeyio/StackOS" target="_blank" rel="noreferrer" data-v-5f58f905>GitHub ↗</a></div></div><div class="site-footer__status" data-v-5f58f905><span class="status-dot" data-v-5f58f905></span><div data-v-5f58f905><strong data-v-5f58f905>Runs on your Mac</strong><small data-v-5f58f905>Your work. Your apps. Your private logins.</small></div></div></div><div class="shell site-footer__bottom" data-v-5f58f905><span data-v-5f58f905>StackOS · Your AI tool works. StackOS keeps the work organized.</span><span data-v-5f58f905>Runs locally.</span></div></footer></div><!----><!--]--></div><div id="teleports"></div><script>window.__NUXT__={};window.__NUXT__.config={public:{siteUrl:"https://stackos.flowmonkey.io",gaMeasurementId:"G-KPZXCGXGG5",downloadUrl:"https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg",scripts:{googleAnalytics:{id:"G-KPZXCGXGG5",scriptOptions:{bundle:false}}},"nuxt-scripts":{version:"",prefix:"/_scripts",defaultScriptOptions:{trigger:"onNuxtReady"},googleStaticMapsProxy:"",endpoints:{}},mdc:{components:{prose:true,map:{},customElements:[]},headings:{anchorLinks:{h1:false,h2:true,h3:true,h4:true,h5:false,h6:false}},highlight:false},"nuxt-seo-utils-version":"8.3.1","seo-utils":{canonicalQueryWhitelist:["page","sort","filter","search","q","category","tag"],canonicalLowercase:true,tagPriority:"low",separator:"",titleSeparator:""},content:{wsUrl:""},"nuxt-robots":{version:"6.1.2",isNuxtContentV2:false,debug:false,credits:true,groups:[{userAgent:["*"],disallow:[""],allow:[],contentUsage:[],contentSignal:[],_indexable:true,_rules:[],_normalized:true}],sitemap:["/sitemap.xml"],header:true,robotsEnabledValue:"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",robotsDisabledValue:"noindex, nofollow",cacheControl:"max-age=14400,