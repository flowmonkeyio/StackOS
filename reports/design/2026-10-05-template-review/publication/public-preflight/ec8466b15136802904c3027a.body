k rel="modulepreload" as="script" crossorigin href="/_nuxt/B6FA65gX.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/CBNv9QJs.js"><script type="module" src="/_nuxt/BT73oLzS.js" crossorigin></script><link rel="icon" type="image/png" href="/images/stackos-icon.png"><link rel="apple-touch-icon" href="/images/stackos-icon.png"><link rel="alternate" type="application/rss+xml" title="StackOS Library" href="/feed.xml"><meta name="description" content="A coherent campaign package with approved messaging, generated assets, landing-page variants, a visual review, and a local evidence gallery."><meta name="theme-color" content="#090b10"><meta property="og:type" content="website"><meta property="og:title" content="Marketing Campaign Production workflow | StackOS"><meta property="og:description" content="A coherent campaign package with approved messaging, generated assets, landing-page variants, a visual review, and a local evidence gallery."><meta name="twitter:title" content="Marketing Campaign Production workflow | StackOS"><meta name="twitter:description" content="A coherent campaign package with approved messaging, generated assets, landing-page variants, a visual review, and a local evidence gallery."><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"><link rel="canonical" href="https://stackos.flowmonkey.io/library/workflows/marketing-campaign-production/"><meta property="og:url" content="https://stackos.flowmonkey.io/library/workflows/marketing-campaign-production/"><meta property="og:site_name" content="StackOS"><script id="unhead:payload" type="application/json">{"titleTemplate":"%s | StackOS"}</script></head><body><div id="__nuxt"><!--[--><div id="top" class="site library-site" data-v-58a46588 data-v-e230b581><a class="skip-link" href="#main" data-v-e230b581>Skip to content</a><header class="site-header" data-v-e230b581><div class="shell site-header__inner"><a href="/" class="brand" aria-label="StackOS home"><img src="/images/stackos-icon.png" alt width="36" height="36"><span>StackOS</span><small>Work, organized</small></a><nav class="site-nav site-nav--desktop" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav><details class="mobile-menu"><summary role="button" aria-label="Toggle navigation" aria-controls="site-navigation"><span></span><span></span></summary><nav id="site-navigation" class="site-nav site-nav--mobile" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav></details></div></header><div class="library-nav" aria-label="Library sections" data-v-e230b581><div class="shell library-nav__inner" data-v-e230b581><a href="/library/" class="" data-v-e230b581>Library</a><a href="/library/workflows/" class="" data-v-e230b581>Workflows</a><a href="/library/agents/" class="" data-v-e230b581>Agents</a><a href="/library/orchestrators/" class="" data-v-e230b581>Orchestrators</a><a href="/library/integrations/" class="" data-v-e230b581>Integrations</a><a href="/library/articles/" class="" data-v-e230b581>Articles</a></div></div><main id="main" class="library-main" data-v-e230b581><nav class="library-breadcrumbs" aria-label="Breadcrumb" data-v-e230b581 data-v-59391fa3><div class="shell" data-v-59391fa3><ol data-v-59391fa3><!--[--><li data-v-59391fa3><a href="/" class="" data-v-59391fa3>Home</a></li><li data-v-59391fa3><a href="/library/" class="" data-v-59391fa3>Library</a></li><li data-v-59391fa3><a href="/library/workflows/" class="" data-v-59391fa3>Workflows</a></li><li data-v-59391fa3><a aria-current="page" href="/library/workflows/marketing-campaign-production/" class="router-link-active router-link-exact-active" data-v-59391fa3>Marketing Campaign Production</a></li><!--]--></ol></div></nav><!--[--><section class="detail-hero" data-v-58a46588><div class="shell detail-hero__grid" data-v-58a46588><div data-v-58a46588><p class="library-kicker" data-v-58a46588>Marketing teams producing multi-asset campaigns / marketing</p><h1 data-v-58a46588>Marketing Campaign Production</h1><p class="detail-hero__lede" data-v-58a46588>A coherent campaign package with approved messaging, generated assets, landing-page variants, a visual review, and a local evidence gallery.</p><div class="detail-tags" data-v-58a46588><span data-v-58a46588>8 stages</span><span data-v-58a46588>6 specialist agents</span><span data-v-58a46588>Depends on the selected path</span></div></div><div class="generated-visual generated-visual--workflow detail-hero__visual" style="--visual-color:#d9ff63;" role="img" aria-label="A complete plan you can follow. Marketing Campaign Production. From request to result." data-v-58a46588 data-v-9361e887><header class="generated-visual__header" data-v-9361e887><div data-v-9361e887><span data-v-9361e887>From request to result</span><strong data-v-9361e887>A complete plan you can follow.</strong></div><small data-v-9361e887>Visible plan</small></header><div class="generated-visual__lane" aria-hidden="true" data-v-9361e887><div class="visual-node visual-node--clients" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Start in your AI</span><div class="client-list" data-v-9361e887><!--[--><span class="client-chip" data-v-9361e887><img src="/images/openai.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Codex</b></span><span class="client-chip" data-v-9361e887><img src="/images/claude.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Claude</b></span><span class="client-chip" data-v-9361e887><img src="/images/gemini.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Gemini</b></span><!--]--></div></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--stackos" data-v-9361e887><img src="/images/stackos-icon.png" alt="" width="42" height="42" loading="lazy" decoding="async" data-v-9361e887><strong data-v-9361e887>StackOS</strong><small data-v-9361e887>Builds the plan</small></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--outcome" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Visible stages</span><div class="outcome-list" data-v-9361e887><!--[--><span data-v-9361e887><b data-v-9361e887>1</b> Plan</span><span data-v-9361e887><b data-v-9361e887>2</b> Do</span><span data-v-9361e887><b data-v-9361e887>3</b> Check</span><!--]--></div></div></div></div></div></section><section class="detail-body" data-v-58a46588><div class="detail-body__narrow" data-v-58a46588><p class="eyebrow" data-v-58a46588>The problem</p><h2 data-v-58a46588>Campaign production fragments the brief, messaging, media, landing pages, and review across disconnected tools and approvals.</h2><p class="detail-body__intro" data-v-58a46588>AI can coordinate several creative and mechanical specialties while retaining one brief, shared constraints, and independent visual signoff.</p></div><div class="shell experience-grid" data-v-58a46588><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What you do</p><ol data-v-58a46588><!--[--><li data-v-58a46588>Provide the product, audience, offer, brand constraints, and desired media.</li><li data-v-58a46588>Confirm the campaign plan and generation budget before production.</li><li data-v-58a46588>Review the final gallery and approve or reject each deliverable.</li><!--]--></ol></article><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What the agent does</p><ol data-v-58a46588><!--[--><li data-v-58a46588>Resolve the brief and brand evidence before choosing concepts or tools.</li><li data-v-58a46588>Plan media and page variants, then produce through explicit provider routes.</li><li data-v-58a46588>Verify requirements, run independent visual signoff, and assemble the evidence gallery.</li><!--]--></ol></article></div><div class="detail-body__narrow detail-space" data-v-58a46588><p class="eyebrow" data-v-58a46588>When this workflow helps</p><h2 data-v-58a46588>A reusable method, adapted to the request.</h2><ul class="detail-list" data-v-58a46588><!--[--><li data-v-58a46588>A user asks to produce a marketing campaign from a brand identity, product description, and product photo.</li><li data-v-58a46588>Campaign media (images, short videos), landing page variants, and a reviewable gallery should be produced together with durable state and signoff evidence.</li><li data-v-58a46588>Landing page A/B variants and their media requirements should be planned and approved before any generation spend.</li><!--]--></ul></div><div class="shell readiness-grid" data-v-58a46588><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>Before it starts</p><h3 data-v-58a46588>Depends on the selected path</h3><ul data-v-58a46588><!--[--><li data-v-58a46588>A product brief, audience, offer, and brand profile</li><li data-v-58a46588>Approved product media and disclosure boundaries</li><li data-v-58a46588>Generation budget and provider route for selected media</li><!--]--></ul></article><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What proves it worked</p><h3 data-v-58a46588>Evidence, not a success claim.</h3><ul data-v-58a46588><!--[--><li data-v-58a46588>Requirement-linked campaign plan</li><li data-v-58a46588>Provider generation receipts</li><li data-v-58a46588>Landing-page verification</li><li data-v-58a46588>Independent visual signoff</li><li data-v-58a46588>Complete local gallery</li><!--]--></ul></article></div><div class="shell workflow-showcase" data-v-58a46588><div class="library-section__heading" data-v-58a46588><div data-v-58a46588><p class="eyebrow" data-v-58a46588>Workflow path</p><h2 data-v-58a46588>The reusable stages of the work.</h2></div><p data-v-58a46588>A real run expands these stages around the request, context, selected tools, approvals, and dependencies.</p></div><section class="workflow-map" style="--workflow-color:#ff78ac;" aria-labelledby="workflow-map-title" data-v-58a46588 data-v-110563eb><header data-v-110563eb><span class="status-dot" data-v-110563eb></span><strong id="workflow-map-title" data-v-110563eb>8 ordered workflow stages</strong></header><ol aria-label="Workflow stages" data-v-110563eb><!--[--><li data-workflow-stage data-v-110563eb><span data-v-110563eb>01</span><div data-v-110563eb><h3 data-v-110563eb>Intake Campaign Brief</h3><p data-v-110563eb>Convert operator inputs into a complete structured campaign brief with persisted input artifacts and an explicit media request.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>02</span><div data-v-110563eb><h3 data-v-110563eb>Set Up Campaign Workspace</h3><p data-v-110563eb>Create the repository campaign workspace and scaffold campaign.md as the operator-readable campaign ledger.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>03</span><div data-v-110563eb><h3 data-v-110563eb>Plan Campaign And Media Manifest</h3><p data-v-110563eb>Produce the campaign plan that production executes and signoff verifies; media manifest, landing page variant plans, gallery plan, and cost estimate.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>04</span><div data-v-110563eb><h3 data-v-110563eb>Produce Campaign Media</h3><p data-v-110563eb>Execute approved manifest entries through granted generation actions and materialize results into the campaign workspace.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>05</span><div data-v-110563eb><h3 data-v-110563eb>Build Landing Page Variants</h3><p data-v-110563eb>Build each planned variant as a self-contained static page in the workspace using produced media and the approved angle.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>06</span><div data-v-110563eb><h3 data-v-110563eb>Visual Signoff</h3><p data-v-110563eb>Verify every produced asset and page against the approved plan with rendered evidence and explicit per-item verdicts.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>07</span><div data-v-110563eb><h3 data-v-110563eb>Build Campaign Gallery</h3><p data-v-110563eb>Build the local human-readable gallery page that presents everything the campaign produced to a non-engineer.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>08</span><div data-v-110563eb><h3 data-v-110563eb>Campaign Closeout</h3><p data-v-110563eb>Reconcile state, finalize the campaign ledger, and hand the operator one front door to everything produced.</p></div><small data-v-110563eb>Verified outcome</small></li><!--]--></ol></section></div><div class="detail-body__narrow" style="margin-top:88px;" data-v-58a46588><!--[--><p class="eyebrow" data-v-58a46588>Safe stopping and recovery</p><h2 data-v-58a46588>Useful even when the whole path cannot run.</h2><ul class="detail-list" data-v-58a46588><!--[--><li data-v-58a46588>Stop after the confirmed production plan when generation spend was not approved.</li><!--]--><!--[--><li data-v-58a46588>If brand or product evidence is missing, pause before creative production.</li><li data-v-58a46588>Preserve completed assets and provider receipts when one route fails; resume only the blocked branch.</li><!--]--></ul><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Documented follow-on work</p><h2 data-v-58a46588>The next workflow is conditional, not hidden.</h2><div class="handoff-list" data-v-58a46588><!--[--><a href="/library/workflows/media-buying-campaign-launch/" class="" data-v-58a46588><span data-v-58a46588>conditional</span><strong data-v-58a46588>Media Buying Campaign Launch</strong><p data-v-58a46588>The approved campaign package is intended for a paid-media launch.</p></a><!--]--></div><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Specialists inside this workflow</p><h2 data-v-58a46588>Clear roles for each part of the job.</h2><div class="detail-link-grid" data-v-58a46588><!--[--><a href="/library/agents/marketing-campaign-brief-analyst/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Campaign Brief Analyst</strong><b aria-hidden="true" data-v-58a46588>→</b></a><a href="/library/agents/marketing-campaign-creative-director/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Campaign Creative Director</strong><b aria-hidden="true" data-v-58a46588>→</b></a><a href="/library/agents/marketing-campaign-media-producer/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Campaign Media Producer</strong><b aria-hidden="true" data-v-58a46588>→</b></a><a href="/library/agents/marketing-campaign-landing-page-builder/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Campaign Landing Page Builder</strong><b aria-hidden="true" data-v-58a46588>→</b></a><a href="/library/agents/marketing-campaign-visual-signoff-reviewer/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Campaign Visual Signoff Reviewer</strong><b aria-hidden="true" data-v-58a46588>→</b></a><a href="/library/agents/branding-voice-reviewer/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Branding Voice Reviewer</strong><b aria-hidden="true" data-v-58a46588>→</b></a><!--]--></div><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Connected work</p><h2 data-v-58a46588>Built to use the tools you already have.</h2><div class="detail-tags detail-tags--paper" data-v-58a46588><!--[--><span data-v-58a46588>Openai Images</span><span data-v-58a46588>Google Veo</span><span data-v-58a46588>Byteplus Ark</span><span data-v-58a46588>Alibaba Wan</span><span data-v-58a46588>Kling</span><span data-v-58a46588>Xai Imagine</span><!--]--></div><!--]--></div></section><!----><!--]--></main><footer class="site-footer" data-v-e230b581 data-v-5f58f905><div class="shell site-footer__grid" data-v-5f58f905><a href="/" class="footer-brand" data-v-5f58f905><img src="/images/stackos-icon.png" alt width="42" height="42" loading="lazy" decoding="async" data-v-5f58f905><div data-v-5f58f905><strong data-v-5f58f905>StackOS</strong><span data-v-5f58f905>Keep AI-powered work clear, connected, and moving.</span></div></a><div class="site-footer__links" data-v-5f58f905><div data-v-5f58f905><span data-v-5f58f905>Explore</span><a href="/#why" class="" data-v-5f58f905>Why Stack