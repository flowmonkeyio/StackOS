R.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/B6FA65gX.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/CBNv9QJs.js"><script type="module" src="/_nuxt/BT73oLzS.js" crossorigin></script><link rel="icon" type="image/png" href="/images/stackos-icon.png"><link rel="apple-touch-icon" href="/images/stackos-icon.png"><link rel="alternate" type="application/rss+xml" title="StackOS Library" href="/feed.xml"><meta name="description" content="A source-linked diagnosis with ranked hypotheses, evidence gaps, and a recommendation for no change, budget review, creative work, or an experiment."><meta name="theme-color" content="#090b10"><meta property="og:type" content="website"><meta property="og:title" content="Media Buying Performance Diagnosis workflow | StackOS"><meta property="og:description" content="A source-linked diagnosis with ranked hypotheses, evidence gaps, and a recommendation for no change, budget review, creative work, or an experiment."><meta name="twitter:title" content="Media Buying Performance Diagnosis workflow | StackOS"><meta name="twitter:description" content="A source-linked diagnosis with ranked hypotheses, evidence gaps, and a recommendation for no change, budget review, creative work, or an experiment."><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"><link rel="canonical" href="https://stackos.flowmonkey.io/library/workflows/media-buying-performance-diagnosis/"><meta property="og:url" content="https://stackos.flowmonkey.io/library/workflows/media-buying-performance-diagnosis/"><meta property="og:site_name" content="StackOS"><script id="unhead:payload" type="application/json">{"titleTemplate":"%s | StackOS"}</script></head><body><div id="__nuxt"><!--[--><div id="top" class="site library-site" data-v-58a46588 data-v-e230b581><a class="skip-link" href="#main" data-v-e230b581>Skip to content</a><header class="site-header" data-v-e230b581><div class="shell site-header__inner"><a href="/" class="brand" aria-label="StackOS home"><img src="/images/stackos-icon.png" alt width="36" height="36"><span>StackOS</span><small>Work, organized</small></a><nav class="site-nav site-nav--desktop" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav><details class="mobile-menu"><summary role="button" aria-label="Toggle navigation" aria-controls="site-navigation"><span></span><span></span></summary><nav id="site-navigation" class="site-nav site-nav--mobile" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav></details></div></header><div class="library-nav" aria-label="Library sections" data-v-e230b581><div class="shell library-nav__inner" data-v-e230b581><a href="/library/" class="" data-v-e230b581>Library</a><a href="/library/workflows/" class="" data-v-e230b581>Workflows</a><a href="/library/agents/" class="" data-v-e230b581>Agents</a><a href="/library/orchestrators/" class="" data-v-e230b581>Orchestrators</a><a href="/library/integrations/" class="" data-v-e230b581>Integrations</a><a href="/library/articles/" class="" data-v-e230b581>Articles</a></div></div><main id="main" class="library-main" data-v-e230b581><nav class="library-breadcrumbs" aria-label="Breadcrumb" data-v-e230b581 data-v-59391fa3><div class="shell" data-v-59391fa3><ol data-v-59391fa3><!--[--><li data-v-59391fa3><a href="/" class="" data-v-59391fa3>Home</a></li><li data-v-59391fa3><a href="/library/" class="" data-v-59391fa3>Library</a></li><li data-v-59391fa3><a href="/library/workflows/" class="" data-v-59391fa3>Workflows</a></li><li data-v-59391fa3><a aria-current="page" href="/library/workflows/media-buying-performance-diagnosis/" class="router-link-active router-link-exact-active" data-v-59391fa3>Media Buying Performance Diagnosis</a></li><!--]--></ol></div></nav><!--[--><section class="detail-hero" data-v-58a46588><div class="shell detail-hero__grid" data-v-58a46588><div data-v-58a46588><p class="library-kicker" data-v-58a46588>Paid-media teams diagnosing performance changes before acting / media buying</p><h1 data-v-58a46588>Media Buying Performance Diagnosis</h1><p class="detail-hero__lede" data-v-58a46588>A source-linked diagnosis with ranked hypotheses, evidence gaps, and a recommendation for no change, budget review, creative work, or an experiment.</p><div class="detail-tags" data-v-58a46588><span data-v-58a46588>4 stages</span><span data-v-58a46588>2 specialist agents</span><span data-v-58a46588>Depends on the selected path</span></div></div><div class="generated-visual generated-visual--workflow detail-hero__visual" style="--visual-color:#d9ff63;" role="img" aria-label="A complete plan you can follow. Media Buying Performance Diagnosis. From request to result." data-v-58a46588 data-v-9361e887><header class="generated-visual__header" data-v-9361e887><div data-v-9361e887><span data-v-9361e887>From request to result</span><strong data-v-9361e887>A complete plan you can follow.</strong></div><small data-v-9361e887>Visible plan</small></header><div class="generated-visual__lane" aria-hidden="true" data-v-9361e887><div class="visual-node visual-node--clients" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Start in your AI</span><div class="client-list" data-v-9361e887><!--[--><span class="client-chip" data-v-9361e887><img src="/images/openai.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Codex</b></span><span class="client-chip" data-v-9361e887><img src="/images/claude.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Claude</b></span><span class="client-chip" data-v-9361e887><img src="/images/gemini.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Gemini</b></span><!--]--></div></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--stackos" data-v-9361e887><img src="/images/stackos-icon.png" alt="" width="42" height="42" loading="lazy" decoding="async" data-v-9361e887><strong data-v-9361e887>StackOS</strong><small data-v-9361e887>Builds the plan</small></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--outcome" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Visible stages</span><div class="outcome-list" data-v-9361e887><!--[--><span data-v-9361e887><b data-v-9361e887>1</b> Plan</span><span data-v-9361e887><b data-v-9361e887>2</b> Do</span><span data-v-9361e887><b data-v-9361e887>3</b> Check</span><!--]--></div></div></div></div></div></section><section class="detail-body" data-v-58a46588><div class="detail-body__narrow" data-v-58a46588><p class="eyebrow" data-v-58a46588>The problem</p><h2 data-v-58a46588>When paid performance worsens, teams jump to budget or creative changes before separating measurement, audience, channel, page, and market causes.</h2><p class="detail-body__intro" data-v-58a46588>AI can compare multiple causal categories and time windows systematically while keeping uncertainty and business judgment visible.</p></div><div class="shell experience-grid" data-v-58a46588><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What you do</p><ol data-v-58a46588><!--[--><li data-v-58a46588>Name the affected accounts and campaigns, what changed, the KPI, and the comparison window.</li><li data-v-58a46588>Provide exports or select one read-only provider route.</li><li data-v-58a46588>Review the diagnosis before starting any mutation workflow.</li><!--]--></ol></article><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What the agent does</p><ol data-v-58a46588><!--[--><li data-v-58a46588>Validate measurement and comparison quality before explaining performance.</li><li data-v-58a46588>Use stored evidence or one ready metric-source route; unavailable alternatives stay optional.</li><li data-v-58a46588>Rank causal hypotheses, name counter-evidence and gaps, and recommend the smallest useful next step.</li><li data-v-58a46588>Stop after diagnosis unless the operator starts a follow-up workflow.</li><!--]--></ol></article></div><div class="detail-body__narrow detail-space" data-v-58a46588><p class="eyebrow" data-v-58a46588>When this workflow helps</p><h2 data-v-58a46588>A reusable method, adapted to the request.</h2><ul class="detail-list" data-v-58a46588><!--[--><li data-v-58a46588>A campaign, channel, creative set, or audience needs a performance review.</li><li data-v-58a46588>The agent should retrieve only relevant historical fields before diagnosing.</li><!--]--></ul></div><div class="shell readiness-grid" data-v-58a46588><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>Before it starts</p><h3 data-v-58a46588>Depends on the selected path</h3><ul data-v-58a46588><!--[--><li data-v-58a46588>Affected accounts and campaigns</li><li data-v-58a46588>The exact change date, KPI target, comparison window, and attribution assumptions</li><li data-v-58a46588>Stored snapshots, exports, or one ready read-only provider route</li><!--]--></ul></article><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What proves it worked</p><h3 data-v-58a46588>Evidence, not a success claim.</h3><ul data-v-58a46588><!--[--><li data-v-58a46588>Measurement-quality check</li><li data-v-58a46588>Evidence table and ranked hypotheses</li><li data-v-58a46588>Counter-evidence and data gaps</li><li data-v-58a46588>Recommendation with explicit no-mutation boundary</li><!--]--></ul></article></div><div class="shell workflow-showcase" data-v-58a46588><div class="library-section__heading" data-v-58a46588><div data-v-58a46588><p class="eyebrow" data-v-58a46588>Workflow path</p><h2 data-v-58a46588>The reusable stages of the work.</h2></div><p data-v-58a46588>A real run expands these stages around the request, context, selected tools, approvals, and dependencies.</p></div><section class="workflow-map" style="--workflow-color:#ffbd5c;" aria-labelledby="workflow-map-title" data-v-58a46588 data-v-110563eb><header data-v-110563eb><span class="status-dot" data-v-110563eb></span><strong id="workflow-map-title" data-v-110563eb>4 ordered workflow stages</strong></header><ol aria-label="Workflow stages" data-v-110563eb><!--[--><li data-workflow-stage data-v-110563eb><span data-v-110563eb>01</span><div data-v-110563eb><h3 data-v-110563eb>Orient From Performance Context</h3><p data-v-110563eb>Read the review scope, metric targets, recent snapshots, related learnings, and active experiments.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>02</span><div data-v-110563eb><h3 data-v-110563eb>Fetch Additional Metrics</h3><p data-v-110563eb>Execute only the selected read action that the concrete run plan grants for missing evidence.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>03</span><div data-v-110563eb><h3 data-v-110563eb>Diagnose Drivers</h3><p data-v-110563eb>Compare evidence against targets and separate likely channel, audience, creative, landing page, and budget drivers.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>04</span><div data-v-110563eb><h3 data-v-110563eb>Record Followups</h3><p data-v-110563eb>Store recommended follow-up resources, budget review notes, and learning candidates for later review without executing a mutation.</p></div><small data-v-110563eb>Verified outcome</small></li><!--]--></ol></section></div><div class="detail-body__narrow" style="margin-top:88px;" data-v-58a46588><!--[--><p class="eyebrow" data-v-58a46588>Safe stopping and recovery</p><h2 data-v-58a46588>Useful even when the whole path cannot run.</h2><ul class="detail-list" data-v-58a46588><!--[--><li data-v-58a46588>This workflow is recommendation-first and stops before budget, creative, page, or campaign mutation.</li><!--]--><!--[--><li data-v-58a46588>If evidence is insufficient, recommend no change and list the minimum missing data.</li><li data-v-58a46588>If a live provider is unavailable, use supplied exports or stored snapshots rather than blocking on every provider.</li><!--]--></ul><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Documented follow-on work</p><h2 data-v-58a46588>The next workflow is conditional, not hidden.</h2><div class="handoff-list" data-v-58a46588><!--[--><a href="/library/workflows/media-buying-budget-reallocation-review/" class="" data-v-58a46588><span data-v-58a46588>conditional</span><strong data-v-58a46588>Media Buying Budget Reallocation Review</strong><p data-v-58a46588>Allocation is a supported cause and budget movement should be reviewed.</p></a><a href="/library/workflows/media-buying-creative-variant-generation/" class="" data-v-58a46588><span data-v-58a46588>conditional</span><strong data-v-58a46588>Media Buying Creative Variant Generation</strong><p data-v-58a46588>Creative fatigue or mismatch is a supported cause.</p></a><a href="/library/workflows/media-buying-landing-page-creative-experiment/" class="" data-v-58a46588><span data-v-58a46588>conditional</span><strong data-v-58a46588>Landing Page And Creative Experiment</strong><p data-v-58a46588>The evidence supports a measured creative or destination experiment.</p></a><!--]--></div><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Specialists inside this workflow</p><h2 data-v-58a46588>Clear roles for each part of the job.</h2><div class="detail-link-grid" data-v-58a46588><!--[--><a href="/library/agents/media-buying-workflow-performance-diagnosis/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Media Performance Diagnosis Agent</strong><b aria-hidden="true" data-v-58a46588>→</b></a><a href="/library/agents/stackos-sdlc-delivery-reviewer/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Review Agent</strong><b aria-hidden="true" data-v-58a46588>→</b></a><!--]--></div><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Connected work</p><h2 data-v-58a46588>Built to use the tools you already have.</h2><div class="detail-tags detail-tags--paper" data-v-58a46588><!--[--><span data-v-58a46588>Meta Ads</span><span data-v-58a46588>Google Ads</span><span data-v-58a46588>Taboola</span><span data-v-58a46588>Custom Media Tool</span><!--]--></div><!--]--></div></section><section class="related-section" data-v-58a46588><div class="shell" data-v-58a46588><div class="library-section__heading" data-v-58a46588><div data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>Keep exploring</p><h2 data-v-58a46588>Related workflows.</h2></div><a href="/library/workflows/" class="" data-v-58a46588>See all 36 →</a></div><div class="library-grid" data-v-58a46588><!--[--><a href="/library/workflows/media-buying-landing-page-creative-experiment/" class="catalog-card" style="--card-color:#ffbd5c;" data-v-58a46588 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>media buying</b></div><h3 data-v-661e3dea>Landing Page And Creative Experiment</h3><p data-v-661e3dea>A launch-ready experiment that connects named variants, destination changes, tracking, guardrails, and one approved provider route.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>4 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/workflows/media-buying-budget-reallocation-review/" class="catalog-card" style="--card-color:#ffbd5c;" data-v-58a46588 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>media buying</b></div><h3 data-v-661e3dea>Media Buying Budget Reallocation Review</h3><p data-v-661e3dea>An evidence-backed budget recommendation, explicit approval boundary, and observation plan; mutations occur only when separately approved.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>4 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/workflows/media-buying-campaign-launch/" class="catalog-card" style="--card-color:#ffbd5c;" data-v-58a46588 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>media buying</b></div><h3 data-v-661e3dea>Media Buying Campaign Launch</h3><p data-v-661e3dea>A provider-specific campaign plan that passes launch checks and creates external campaign objects only after approval.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>5 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><!--]--></div></div></section><!--]--></main><footer class="site-footer" data-v-e230b581 data-v-5f58f905><div class="shell site-footer__grid" data-v-5f58f905><a href="/" class="footer-brand" data-v-5f58f905><img src="/images/stackos-icon.png" alt width="42" height="42" loading="lazy" decoding="async" data-v-5f58f905><div data-v-5f58f905><strong data-v-5f58f905>StackOS</strong><span data-v-5f58f905>Keep AI-powered work clear, connected, and moving.</span></div></a><div class="site-footer__links" data-v-5f58f905><div data-v-5f58f905><span data-v-5f58f905>Explore</span><a href="/#why" class="" data-v-5f58f905>Why StackOS</a><a href="/getting-started/" class="" data-v-5f58f905>Getting started</a><a href="/library/" class="" data-v-5f58f905>Library</a><a href="/library/workflows/" class="" data-v-5f58f905>Workflows</a><a href="/library/articles/" class="" data-v-5f58f905>Articles</a></div><div data-v-5f58f905><span data-v-5f58f905>Build</span><a href="/#security" class="" data-v-5f58f905>Security</a><a href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac" data-v-5f58f905>Download</a><a href="https://github.com/flowmonkeyio/StackOS" target="_blank" rel="noreferrer" data-v-5f58f905>GitHub ↗</a></div></div><div class="site-footer__status" data-v-5f58f905><span class="status-dot" data-v-5f58f905></span><div data-v-5f58f905><strong data-