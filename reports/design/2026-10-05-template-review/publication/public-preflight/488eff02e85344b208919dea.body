><link rel="modulepreload" as="script" crossorigin href="/_nuxt/B6FA65gX.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/CBNv9QJs.js"><script type="module" src="/_nuxt/BT73oLzS.js" crossorigin></script><link rel="icon" type="image/png" href="/images/stackos-icon.png"><link rel="apple-touch-icon" href="/images/stackos-icon.png"><link rel="alternate" type="application/rss+xml" title="StackOS Library" href="/feed.xml"><meta name="description" content="One route-approved Slack thread containing the complete feedback packet and safe refs for investigation."><meta name="theme-color" content="#090b10"><meta property="og:type" content="website"><meta property="og:title" content="Customer Feedback Intake workflow | StackOS"><meta property="og:description" content="One route-approved Slack thread containing the complete feedback packet and safe refs for investigation."><meta name="twitter:title" content="Customer Feedback Intake workflow | StackOS"><meta name="twitter:description" content="One route-approved Slack thread containing the complete feedback packet and safe refs for investigation."><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"><link rel="canonical" href="https://stackos.flowmonkey.io/library/workflows/communications-customer-feedback-intake/"><meta property="og:url" content="https://stackos.flowmonkey.io/library/workflows/communications-customer-feedback-intake/"><meta property="og:site_name" content="StackOS"><script id="unhead:payload" type="application/json">{"titleTemplate":"%s | StackOS"}</script></head><body><div id="__nuxt"><!--[--><div id="top" class="site library-site" data-v-58a46588 data-v-e230b581><a class="skip-link" href="#main" data-v-e230b581>Skip to content</a><header class="site-header" data-v-e230b581><div class="shell site-header__inner"><a href="/" class="brand" aria-label="StackOS home"><img src="/images/stackos-icon.png" alt width="36" height="36"><span>StackOS</span><small>Work, organized</small></a><nav class="site-nav site-nav--desktop" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav><details class="mobile-menu"><summary role="button" aria-label="Toggle navigation" aria-controls="site-navigation"><span></span><span></span></summary><nav id="site-navigation" class="site-nav site-nav--mobile" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav></details></div></header><div class="library-nav" aria-label="Library sections" data-v-e230b581><div class="shell library-nav__inner" data-v-e230b581><a href="/library/" class="" data-v-e230b581>Library</a><a href="/library/workflows/" class="" data-v-e230b581>Workflows</a><a href="/library/agents/" class="" data-v-e230b581>Agents</a><a href="/library/orchestrators/" class="" data-v-e230b581>Orchestrators</a><a href="/library/integrations/" class="" data-v-e230b581>Integrations</a><a href="/library/articles/" class="" data-v-e230b581>Articles</a></div></div><main id="main" class="library-main" data-v-e230b581><nav class="library-breadcrumbs" aria-label="Breadcrumb" data-v-e230b581 data-v-59391fa3><div class="shell" data-v-59391fa3><ol data-v-59391fa3><!--[--><li data-v-59391fa3><a href="/" class="" data-v-59391fa3>Home</a></li><li data-v-59391fa3><a href="/library/" class="" data-v-59391fa3>Library</a></li><li data-v-59391fa3><a href="/library/workflows/" class="" data-v-59391fa3>Workflows</a></li><li data-v-59391fa3><a aria-current="page" href="/library/workflows/communications-customer-feedback-intake/" class="router-link-active router-link-exact-active" data-v-59391fa3>Customer Feedback Intake</a></li><!--]--></ol></div></nav><!--[--><section class="detail-hero" data-v-58a46588><div class="shell detail-hero__grid" data-v-58a46588><div data-v-58a46588><p class="library-kicker" data-v-58a46588>Support and product teams receiving feedback across communication channels / communications</p><h1 data-v-58a46588>Customer Feedback Intake</h1><p class="detail-hero__lede" data-v-58a46588>One route-approved Slack thread containing the complete feedback packet and safe refs for investigation.</p><div class="detail-tags" data-v-58a46588><span data-v-58a46588>4 stages</span><span data-v-58a46588>1 specialist agents</span><span data-v-58a46588>Depends on the selected path</span></div></div><div class="generated-visual generated-visual--workflow detail-hero__visual" style="--visual-color:#d9ff63;" role="img" aria-label="A complete plan you can follow. Customer Feedback Intake. From request to result." data-v-58a46588 data-v-9361e887><header class="generated-visual__header" data-v-9361e887><div data-v-9361e887><span data-v-9361e887>From request to result</span><strong data-v-9361e887>A complete plan you can follow.</strong></div><small data-v-9361e887>Visible plan</small></header><div class="generated-visual__lane" aria-hidden="true" data-v-9361e887><div class="visual-node visual-node--clients" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Start in your AI</span><div class="client-list" data-v-9361e887><!--[--><span class="client-chip" data-v-9361e887><img src="/images/openai.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Codex</b></span><span class="client-chip" data-v-9361e887><img src="/images/claude.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Claude</b></span><span class="client-chip" data-v-9361e887><img src="/images/gemini.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Gemini</b></span><!--]--></div></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--stackos" data-v-9361e887><img src="/images/stackos-icon.png" alt="" width="42" height="42" loading="lazy" decoding="async" data-v-9361e887><strong data-v-9361e887>StackOS</strong><small data-v-9361e887>Builds the plan</small></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--outcome" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Visible stages</span><div class="outcome-list" data-v-9361e887><!--[--><span data-v-9361e887><b data-v-9361e887>1</b> Plan</span><span data-v-9361e887><b data-v-9361e887>2</b> Do</span><span data-v-9361e887><b data-v-9361e887>3</b> Check</span><!--]--></div></div></div></div></div></section><section class="detail-body" data-v-58a46588><div class="detail-body__narrow" data-v-58a46588><p class="eyebrow" data-v-58a46588>The problem</p><h2 data-v-58a46588>Customer feedback arriving across chat or email can lose media, privacy context, and ownership before anyone investigates it.</h2><p class="detail-body__intro" data-v-58a46588>AI can normalize several communication formats and preserve context, while StackOS enforces the configured route and delivery boundary.</p></div><div class="shell experience-grid" data-v-58a46588><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What you do</p><ol data-v-58a46588><!--[--><li data-v-58a46588>Choose the approved source-to-Slack route and the canonical support destination.</li><li data-v-58a46588>Set privacy, redaction, media retention, and task-creation policy.</li><li data-v-58a46588>Send feedback through an approved surface or provide safe message and media refs.</li><!--]--></ol></article><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What the agent does</p><ol data-v-58a46588><!--[--><li data-v-58a46588>Verify the source, route, destination, media inventory, and data-sharing boundary.</li><li data-v-58a46588>Normalize the report without diagnosing it or dropping allowed media.</li><li data-v-58a46588>Create one complete Slack handoff, add the intake signal, and preserve investigation refs.</li><!--]--></ol></article></div><div class="detail-body__narrow detail-space" data-v-58a46588><p class="eyebrow" data-v-58a46588>When this workflow helps</p><h2 data-v-58a46588>A reusable method, adapted to the request.</h2><ul class="detail-list" data-v-58a46588><!--[--><li data-v-58a46588>Customer feedback or a support symptom arrives outside the canonical Slack support thread.</li><li data-v-58a46588>A project needs a single Slack thread before support investigation starts.</li><li data-v-58a46588>Source media, reporter context, route context, and safe message refs must be preserved for later agents.</li><!--]--></ul></div><div class="shell readiness-grid" data-v-58a46588><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>Before it starts</p><h3 data-v-58a46588>Depends on the selected path</h3><ul data-v-58a46588><!--[--><li data-v-58a46588>A named source surface and message or media refs</li><li data-v-58a46588>An approved cross-surface route and Slack target</li><li data-v-58a46588>Privacy, redaction, retention, and media policy</li><!--]--></ul></article><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What proves it worked</p><h3 data-v-58a46588>Evidence, not a success claim.</h3><ul data-v-58a46588><!--[--><li data-v-58a46588>Complete media inventory</li><li data-v-58a46588>Route and target resolution</li><li data-v-58a46588>Slack message or upload receipts</li><li data-v-58a46588>Linked canonical thread ref</li><!--]--></ul></article></div><div class="shell workflow-showcase" data-v-58a46588><div class="library-section__heading" data-v-58a46588><div data-v-58a46588><p class="eyebrow" data-v-58a46588>Workflow path</p><h2 data-v-58a46588>The reusable stages of the work.</h2></div><p data-v-58a46588>A real run expands these stages around the request, context, selected tools, approvals, and dependencies.</p></div><section class="workflow-map" style="--workflow-color:#7ee2ad;" aria-labelledby="workflow-map-title" data-v-58a46588 data-v-110563eb><header data-v-110563eb><span class="status-dot" data-v-110563eb></span><strong id="workflow-map-title" data-v-110563eb>4 ordered workflow stages</strong></header><ol aria-label="Workflow stages" data-v-110563eb><!--[--><li data-workflow-stage data-v-110563eb><span data-v-110563eb>01</span><div data-v-110563eb><h3 data-v-110563eb>Capture Feedback</h3><p data-v-110563eb>Read the inbound request and source refs, including media inventory and route hints.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>02</span><div data-v-110563eb><h3 data-v-110563eb>Establish Canonical Thread</h3><p data-v-110563eb>Reuse a Slack-origin thread or create one route-approved Slack handoff that preserves source context and media.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>03</span><div data-v-110563eb><h3 data-v-110563eb>Add Intake Reaction</h3><p data-v-110563eb>Mark the canonical Slack message with a reaction that indicates support intake has started.</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>04</span><div data-v-110563eb><h3 data-v-110563eb>Prepare Investigation Handoff</h3><p data-v-110563eb>Return the refs and concise support context needed to start support.issue-investigation without re-discovering the source message.</p></div><small data-v-110563eb>Verified outcome</small></li><!--]--></ol></section></div><div class="detail-body__narrow" style="margin-top:88px;" data-v-58a46588><!--[--><p class="eyebrow" data-v-58a46588>Safe stopping and recovery</p><h2 data-v-58a46588>Useful even when the whole path cannot run.</h2><ul class="detail-list" data-v-58a46588><!--[--><li data-v-58a46588>Stop with a missing-route or privacy question before copying customer content.</li><!--]--><!--[--><li data-v-58a46588>Stop before sending if any required media cannot be forwarded safely.</li><li data-v-58a46588>On partial provider failure, avoid duplicate sends and resume from the stored delivery receipt.</li><!--]--></ul><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Documented follow-on work</p><h2 data-v-58a46588>The next workflow is conditional, not hidden.</h2><div class="handoff-list" data-v-58a46588><!--[--><a href="/library/workflows/support-issue-investigation/" class="" data-v-58a46588><span data-v-58a46588>next</span><strong data-v-58a46588>Issue Investigation</strong><p data-v-58a46588>The complete feedback packet exists in the approved Slack thread.</p></a><!--]--></div><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Specialists inside this workflow</p><h2 data-v-58a46588>Clear roles for each part of the job.</h2><div class="detail-link-grid" data-v-58a46588><!--[--><a href="/library/agents/communications-workflow-customer-feedback-intake/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Communications Customer Feedback Intake Agent</strong><b aria-hidden="true" data-v-58a46588>→</b></a><!--]--></div><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Connected work</p><h2 data-v-58a46588>Built to use the tools you already have.</h2><div class="detail-tags detail-tags--paper" data-v-58a46588><!--[--><span data-v-58a46588>Slack Bot</span><span data-v-58a46588>Telegram</span><!--]--></div><!--]--></div></section><section class="related-section" data-v-58a46588><div class="shell" data-v-58a46588><div class="library-section__heading" data-v-58a46588><div data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>Keep exploring</p><h2 data-v-58a46588>Related workflows.</h2></div><a href="/library/workflows/" class="" data-v-58a46588>See all 36 →</a></div><div class="library-grid" data-v-58a46588><!--[--><a href="/library/workflows/communications-inbox-review/" class="catalog-card" style="--card-color:#7ee2ad;" data-v-58a46588 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>communications</b></div><h3 data-v-661e3dea>Communications Inbox Review</h3><p data-v-661e3dea>A bounded inbox review with selected messages summarized, classified, and turned into explicit follow-up only when authorized.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>5 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/workflows/communications-outbound-notification/" class="catalog-card" style="--card-color:#7ee2ad;" data-v-58a46588 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>communications</b></div><h3 data-v-661e3dea>Communications Outbound Notification</h3><p data-v-661e3dea>One approved notification delivered to a named destination with an auditable source and receipt.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>3 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/workflows/communications-rich-telegram-reply/" class="catalog-card" style="--card-color:#7ee2ad;" data-v-58a46588 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>communications</b></div><h3 data-v-661e3dea>Rich Telegram Reply</h3><p data-v-661e3dea>One Telegram reply whose text, media, buttons, and thread context match the approved response contract.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>3 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><!--]--></div></div></section><!--]--></main><footer class="site-footer" data-v-e230b581 data-v-5f58f905><div class="shell site-footer__grid" data-v-5f58f905><a href="/" class="footer-brand" data-v-5f58f905><img src="/images/stackos-icon.png" alt width="42" height="42" loading="lazy" decoding="async" data-v-5f58f905><div data-v-5f58f905><strong data-v-5f58f905>StackOS</strong><span data-v-5f58f905>Keep AI-powered work clear, connected, and moving.</span></div></a><div class="site-footer__links" data-v-5f58f905><div data-v-5f58f905><span data-v-5f58f905>Explore</span><a href="/#why" class="" data-v-5f58f905>Why StackOS</a><a href="/getting-started/" class="" data-v-5f58f905>Getting started</a><a href=