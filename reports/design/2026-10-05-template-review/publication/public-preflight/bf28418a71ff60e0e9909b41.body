ad" as="script" crossorigin href="/_nuxt/B6FA65gX.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/CBNv9QJs.js"><script type="module" src="/_nuxt/BT73oLzS.js" crossorigin></script><link rel="icon" type="image/png" href="/images/stackos-icon.png"><link rel="apple-touch-icon" href="/images/stackos-icon.png"><link rel="alternate" type="application/rss+xml" title="StackOS Library" href="/feed.xml"><meta name="description" content="A reviewed report with a list of pages checked, evidence for each finding, and recommended fixes in priority order. It explains missing data and coverage limits without changing the website."><meta name="theme-color" content="#090b10"><meta property="og:type" content="website"><meta property="og:title" content="Website SEO Analysis workflow | StackOS"><meta property="og:description" content="A reviewed report with a list of pages checked, evidence for each finding, and recommended fixes in priority order. It explains missing data and coverage limits without changing the website."><meta name="twitter:title" content="Website SEO Analysis workflow | StackOS"><meta name="twitter:description" content="A reviewed report with a list of pages checked, evidence for each finding, and recommended fixes in priority order. It explains missing data and coverage limits without changing the website."><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"><link rel="canonical" href="https://stackos.flowmonkey.io/library/workflows/seo-website-analysis/"><meta property="og:url" content="https://stackos.flowmonkey.io/library/workflows/seo-website-analysis/"><meta property="og:site_name" content="StackOS"><script id="unhead:payload" type="application/json">{"titleTemplate":"%s | StackOS"}</script></head><body><div id="__nuxt"><!--[--><div id="top" class="site library-site" data-v-58a46588 data-v-e230b581><a class="skip-link" href="#main" data-v-e230b581>Skip to content</a><header class="site-header" data-v-e230b581><div class="shell site-header__inner"><a href="/" class="brand" aria-label="StackOS home"><img src="/images/stackos-icon.png" alt width="36" height="36"><span>StackOS</span><small>Work, organized</small></a><nav class="site-nav site-nav--desktop" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav><details class="mobile-menu"><summary role="button" aria-label="Toggle navigation" aria-controls="site-navigation"><span></span><span></span></summary><nav id="site-navigation" class="site-nav site-nav--mobile" aria-label="Primary"><a href="/#why" class="">Why StackOS</a><a href="/#workflow" class="">Workflows</a><a href="/#proof" class="">Product</a><a href="/getting-started/" class="">Get started</a><a href="/library/" class="">Library</a><a href="/#security" class="">Security</a><a class="button button--header" href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac"><img class="button__logo button__logo--apple" src="/images/apple.webp" alt="" width="18" height="18"> Download for Mac <span aria-hidden="true">↓</span></a></nav></details></div></header><div class="library-nav" aria-label="Library sections" data-v-e230b581><div class="shell library-nav__inner" data-v-e230b581><a href="/library/" class="" data-v-e230b581>Library</a><a href="/library/workflows/" class="" data-v-e230b581>Workflows</a><a href="/library/agents/" class="" data-v-e230b581>Agents</a><a href="/library/orchestrators/" class="" data-v-e230b581>Orchestrators</a><a href="/library/integrations/" class="" data-v-e230b581>Integrations</a><a href="/library/articles/" class="" data-v-e230b581>Articles</a></div></div><main id="main" class="library-main" data-v-e230b581><nav class="library-breadcrumbs" aria-label="Breadcrumb" data-v-e230b581 data-v-59391fa3><div class="shell" data-v-59391fa3><ol data-v-59391fa3><!--[--><li data-v-59391fa3><a href="/" class="" data-v-59391fa3>Home</a></li><li data-v-59391fa3><a href="/library/" class="" data-v-59391fa3>Library</a></li><li data-v-59391fa3><a href="/library/workflows/" class="" data-v-59391fa3>Workflows</a></li><li data-v-59391fa3><a aria-current="page" href="/library/workflows/seo-website-analysis/" class="router-link-active router-link-exact-active" data-v-59391fa3>Website SEO Analysis</a></li><!--]--></ol></div></nav><!--[--><section class="detail-hero" data-v-58a46588><div class="shell detail-hero__grid" data-v-58a46588><div data-v-58a46588><p class="library-kicker" data-v-58a46588>Website owners, SEO teams, and agencies diagnosing search visibility and measurement quality / seo</p><h1 data-v-58a46588>Website SEO Analysis</h1><p class="detail-hero__lede" data-v-58a46588>A reviewed report with a list of pages checked, evidence for each finding, and recommended fixes in priority order. It explains missing data and coverage limits without changing the website.</p><div class="detail-tags" data-v-58a46588><span data-v-58a46588>6 stages</span><span data-v-58a46588>2 specialist agents</span><span data-v-58a46588>Ready with project context</span></div></div><div class="generated-visual generated-visual--workflow detail-hero__visual" style="--visual-color:#d9ff63;" role="img" aria-label="A complete plan you can follow. Website SEO Analysis. From request to result." data-v-58a46588 data-v-9361e887><header class="generated-visual__header" data-v-9361e887><div data-v-9361e887><span data-v-9361e887>From request to result</span><strong data-v-9361e887>A complete plan you can follow.</strong></div><small data-v-9361e887>Visible plan</small></header><div class="generated-visual__lane" aria-hidden="true" data-v-9361e887><div class="visual-node visual-node--clients" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Start in your AI</span><div class="client-list" data-v-9361e887><!--[--><span class="client-chip" data-v-9361e887><img src="/images/openai.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Codex</b></span><span class="client-chip" data-v-9361e887><img src="/images/claude.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Claude</b></span><span class="client-chip" data-v-9361e887><img src="/images/gemini.webp" alt="" width="34" height="34" loading="lazy" decoding="async" data-v-9361e887><b data-v-9361e887>Gemini</b></span><!--]--></div></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--stackos" data-v-9361e887><img src="/images/stackos-icon.png" alt="" width="42" height="42" loading="lazy" decoding="async" data-v-9361e887><strong data-v-9361e887>StackOS</strong><small data-v-9361e887>Builds the plan</small></div><i class="visual-connector" data-v-9361e887><span data-v-9361e887></span></i><div class="visual-node visual-node--outcome" data-v-9361e887><span class="visual-node__label" data-v-9361e887>Visible stages</span><div class="outcome-list" data-v-9361e887><!--[--><span data-v-9361e887><b data-v-9361e887>1</b> Plan</span><span data-v-9361e887><b data-v-9361e887>2</b> Do</span><span data-v-9361e887><b data-v-9361e887>3</b> Check</span><!--]--></div></div></div></div></div></section><section class="detail-body" data-v-58a46588><div class="detail-body__narrow" data-v-58a46588><p class="eyebrow" data-v-58a46588>The problem</p><h2 data-v-58a46588>SEO audits become generic checklists or unsupported scores when the analyst does not map the actual site, reconcile public pages with first-party measurement, and distinguish measured facts from observations and inference.</h2><p class="detail-body__intro" data-v-58a46588>AI can traverse representative templates, reconcile public, first-party, and third-party evidence, and synthesize a practical agency-style roadmap while keeping claims traceable.</p></div><div class="shell experience-grid" data-v-58a46588><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What you do</p><ol data-v-58a46588><!--[--><li data-v-58a46588>Example request: “Use Website SEO Analysis on [website URL]. Focus on our service pages and guides for UK small businesses. Check navigation, page content and indexing signals. Return findings with evidence, priorities and ways to verify a fix.”</li><li data-v-58a46588>Name the business goal, important sections, target markets and anything outside the review. Add a reporting period if you want search or analytics data included.</li><li data-v-58a46588>Connect available tools or supply approved exports. The agent can start from the public site and record the missing data. Review the findings before assigning fixes.</li><!--]--></ol></article><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What the agent does</p><ol data-v-58a46588><!--[--><li data-v-58a46588>Confirm the website, business goal, sections to inspect and reporting period. Choose representative pages and record what is outside the review.</li><li data-v-58a46588>Inspect pages, navigation, links, metadata, robots rules and sitemaps. Add connected search or analytics data when available; otherwise work from the public site and record the gaps.</li><li data-v-58a46588>Have the findings independently reviewed, resolve unsupported claims, and prioritize fixes by likely value, confidence and effort. Include dependencies and a way to check each fix.</li><li data-v-58a46588>Save the report, list of inspected pages and supporting evidence so someone can check the conclusions and assign follow-up work.</li><!--]--></ol></article></div><div class="detail-body__narrow detail-space" data-v-58a46588><p class="eyebrow" data-v-58a46588>When this workflow helps</p><h2 data-v-58a46588>A reusable method, adapted to the request.</h2><ul class="detail-list" data-v-58a46588><!--[--><li data-v-58a46588>A user asks to audit, map, analyze, or diagnose a website&#39;s SEO.</li><li data-v-58a46588>A website needs an agency-style technical, on-page, content, measurement, and optional authority/competitive review.</li><li data-v-58a46588>Connected Search Console, Analytics, Tag Manager, or research tools should enrich a public-site analysis.</li><!--]--></ul></div><div class="shell readiness-grid" data-v-58a46588><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>Before it starts</p><h3 data-v-58a46588>Ready with project context</h3><ul data-v-58a46588><!--[--><li data-v-58a46588>A reachable website URL and the business problem you want the analysis to help with</li><li data-v-58a46588>If relevant, priority pages or sections, target markets and anything the agent must leave outside the review</li><li data-v-58a46588>Optional Search Console, analytics or research access, approved exports and a reporting period; public pages can support a useful analysis when those sources are unavailable</li><!--]--></ul></article><article data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>What proves it worked</p><h3 data-v-58a46588>Evidence, not a success claim.</h3><ul data-v-58a46588><!--[--><li data-v-58a46588>A list of inspected URLs and evidence sources, with inaccessible pages, missing data and sampling limits kept visible.</li><li data-v-58a46588>Each finding names the affected page, observed evidence, likely consequence, priority, proposed fix and a way to check the result.</li><li data-v-58a46588>Illustrative finding: a service index links to an old URL that returns 404. A current page covers the same service. Record both URLs and give the repair higher priority if that link is an important route to the service.</li><li data-v-58a46588>Proposed fix in that example: point the link to the current canonical URL. Verification: fetch the updated index, follow its link, and check that the destination returns 200 with the expected canonical.</li><li data-v-58a46588>An independently reviewed report and prioritized work list. The analysis ends there; changing the website is a separately authorized job.</li><!--]--></ul></article></div><div class="shell workflow-showcase" data-v-58a46588><div class="library-section__heading" data-v-58a46588><div data-v-58a46588><p class="eyebrow" data-v-58a46588>Workflow path</p><h2 data-v-58a46588>The reusable stages of the work.</h2></div><p data-v-58a46588>A real run expands these stages around the request, context, selected tools, approvals, and dependencies.</p></div><section class="workflow-map" style="--workflow-color:#79dfff;" aria-labelledby="workflow-map-title" data-v-58a46588 data-v-110563eb><header data-v-110563eb><span class="status-dot" data-v-110563eb></span><strong id="workflow-map-title" data-v-110563eb>6 ordered workflow stages</strong></header><ol aria-label="Workflow stages" data-v-110563eb><!--[--><li data-workflow-stage data-v-110563eb><span data-v-110563eb>01</span><div data-v-110563eb><h3 data-v-110563eb>Scope The Audit</h3><p data-v-110563eb>Establish the canonical host, business goal, markets, priority/excluded sections, date window, robots/access constraints, expected site size, and a…</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>02</span><div data-v-110563eb><h3 data-v-110563eb>Map The Public Site</h3><p data-v-110563eb>Read the homepage, robots and sitemap signals, primary navigation, representative section/template pages, internal links, redirects/canonicals,…</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>03</span><div data-v-110563eb><h3 data-v-110563eb>Collect Connected Evidence</h3><p data-v-110563eb>Select the smallest useful set of ready Search Console, GA4, GTM, Ahrefs, DataForSEO, and Serper actions with explicit bounded inputs; inspect response…</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>04</span><div data-v-110563eb><h3 data-v-110563eb>Reconcile Evidence And Diagnose</h3><p data-v-110563eb>Reconcile public, first-party, third-party, and operator evidence into the site inventory and finding register across crawl/indexability,…</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>05</span><div data-v-110563eb><h3 data-v-110563eb>Review And Prioritize</h3><p data-v-110563eb>Independently challenge scope coverage and every unsupported or overstated claim, then prioritize accepted findings by impact, confidence, effort,…</p></div><small data-v-110563eb>Passes to next stage</small></li><li data-workflow-stage data-v-110563eb><span data-v-110563eb>06</span><div data-v-110563eb><h3 data-v-110563eb>Finalize And Store The Analysis</h3><p data-v-110563eb>Store the reviewed analysis package and one compact website-seo-analysis record whose evidence index, review summary, executive summary, counts,…</p></div><small data-v-110563eb>Verified outcome</small></li><!--]--></ol></section></div><div class="detail-body__narrow" style="margin-top:88px;" data-v-58a46588><!--[--><p class="eyebrow" data-v-58a46588>Safe stopping and recovery</p><h2 data-v-58a46588>Useful even when the whole path cannot run.</h2><ul class="detail-list" data-v-58a46588><!--[--><li data-v-58a46588>Stop after the analysis package; fixes, publishing, tag changes, and indexing requests require separately authorized work.</li><!--]--><!--[--><li data-v-58a46588>If optional providers are unavailable, continue from public pages and record the missing evidence in the source ledger.</li><li data-v-58a46588>If part of the site is inaccessible, narrow the observed scope and label the limitation instead of claiming a complete crawl.</li><li data-v-58a46588>If the target itself cannot be reached or validated, stop with the exact access failure and evidence collected so far.</li><!--]--></ul><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Documented follow-on work</p><h2 data-v-58a46588>The next workflow is conditional, not hidden.</h2><div class="handoff-list" data-v-58a46588><!--[--><a href="/library/workflows/engineering-tracked-delivery/" class="" data-v-58a46588><span data-v-58a46588>conditional</span><strong data-v-58a46588>Engineering Tracked Delivery</strong><p data-v-58a46588>A reviewed technical SEO finding should become repository delivery work.</p></a><a href="/library/workflows/seo-content-refresh/" class="" data-v-58a46588><span data-v-58a46588>conditional</span><strong data-v-58a46588>SEO Content Refresh</strong><p data-v-58a46588>A reviewed page-level content finding should become a bounded refresh.</p></a><!--]--></div><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Specialists inside this workflow</p><h2 data-v-58a46588>Clear roles for each part of the job.</h2><div class="detail-link-grid" data-v-58a46588><!--[--><a href="/library/agents/seo-workflow-website-analysis/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Website SEO Analysis Agent</strong><b aria-hidden="true" data-v-58a46588>→</b></a><a href="/library/agents/stackos-sdlc-delivery-reviewer/" class="" data-v-58a46588><span data-v-58a46588>Agent</span><strong data-v-58a46588>Review Agent</strong><b aria-hidden="true" data-v-58a46588>→</b></a><!--]--></div><!--]--><!--[--><p class="eyebrow detail-space" data-v-58a46588>Connected work</p><h2 data-v-58a46588>Built to use the tools you already have.</h2><div class="detail-tags detail-tags--paper" data-v-58a46588><!--[--><span data-v-58a46588>Jina</span><span data-v-58a46588>Utils Sitemap Fetch</span><span data-v-58a46588>Firecrawl</span><span data-v-58a46588>Google Search Console</span><span data-v-58a46588>Google Analytics</span><span data-v-58a46588>Google Tag Manager</span><span data-v-58a46588>Ahrefs</span><span data-v-58a46588>Dataforseo</span><span data-v-58a46588>Serper</span><!--]--></div><!--]--></div></section><section class="related-section" data-v-58a46588><div class="shell" data-v-58a46588><div class="library-section__heading" data-v-58a46588><div data-v-58a46588><p class="eyebrow eyebrow--dark" data-v-58a46588>Keep exploring</p><h2 data-v-58a46588>Related workflows.</h2></div><a href="/library/workflows/" class="" data-v-58a46588>See all 36 →</a></div><div class="library-grid" data-v-58a46588><!--[--><a href="/library/workflows/seo-content-refresh/" class="catalog-card" style="--card-color:#79dfff;" data-v-58a46588 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>seo</b></div><h3 data-v-661e3dea>SEO Content Refresh</h3><p data-v-661e3dea>A reviewed page-edit plan, verified changes when authorized, or a later performance check. Each change keeps its source, review and verification record.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>9 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><a href="/library/workflows/seo-keyword-research/" class="catalog-card" style="--card-color:#79dfff;" data-v-58a46588 data-v-661e3dea><div class="catalog-card__visual" aria-hidden="true" data-v-661e3dea><!--[--><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><i data-v-661e3dea></i><span data-v-661e3dea></span><!--]--></div><div class="catalog-card__meta" data-v-661e3dea><span data-v-661e3dea>workflow</span><b data-v-661e3dea>seo</b></div><h3 data-v-661e3dea>SEO Keyword Research</h3><p data-v-661e3dea>A reviewed opportunity map choosing refresh, link, create, overlap investigation, deferral or rejection with existing-page evidence and a clear validation handoff.</p><div class="catalog-card__footer" data-v-661e3dea><span data-v-661e3dea>5 stages</span><b aria-hidden="true" data-v-661e3dea>↗</b></div></a><!--]--></div></div></section><!--]--></main><footer class="site-footer" data-v-e230b581 data-v-5f58f905><div class="shell site-footer__grid" data-v-5f58f905><a href="/" class="footer-brand" data-v-5f58f905><img src="/images/stackos-icon.png" alt width="42" height="42" loading="lazy" decoding="async" data-v-5f58f905><div data-v-5f58f905><strong data-v-5f58f905>StackOS</strong><span data-v-5f58f905>Keep AI-powered work clear, connected, and moving.</span></div></a><div class="site-footer__links" data-v-5f58f905><div data-v-5f58f905><span data-v-5f58f905>Explore</span><a href="/#why" class="" data-v-5f58f905>Why StackOS</a><a href="/getting-started/" class="" data-v-5f58f905>Getting started</a><a href="/library/" class="" data-v-5f58f905>Library</a><a href="/library/workflows/" class="" data-v-5f58f905>Workflows</a><a href="/library/articles/" class="" data-v-5f58f905>Articles</a></div><div data-v-5f58f905><span data-v-5f58f905>Build</span><a href="/#security" class="" data-v-5f58f905>Security</a><a href="https://stackos.flowmonkey.io/StackOS/stackos-latest-mac-arm64.dmg" data-download="stackos-mac" data-v-5f58f905>Download</a><a href="https://github.com/flowmonkeyio/StackOS" target="_blank" rel="noreferrer" data-v-5f58f905>GitHub ↗</a></div></div><div class="site-footer__status" data-v-5f58f905><span class="status-dot" data-v-5f58f905></span><div data-v-5f58f905><strong data-v-5f58f905>Runs on your Mac</strong><small data-v-5